package scoop.terminal.emulator

import scoop.test.*

@Test
private class OscColorTest {
    @Test
    fun x11AndRgbSyntaxHaveDistinctSixteenBitConversionRules() {
        assertEquals(Some(TerminalRgb(0xa000, 0xb000, 0xc000)), parseOscColor("#abc"))
        assertEquals(Some(TerminalRgb(0xaaaa, 0xbbbb, 0xcccc)), parseOscColor("rgb:a/b/c"))
        assertEquals(Some(TerminalRgb(0x1200, 0x3400, 0x5600)), parseOscColor("#123456"))
        assertEquals(Some(TerminalRgb(0x1230, 0x4560, 0x7890)), parseOscColor("#123456789"))
        assertEquals(Some(TerminalRgb(0x1234, 0xabcd, 0xffff)), parseOscColor("#1234abcdffff"))
        assertEquals(Some(TerminalRgb(0x1212, 0x3434, 0x5656)), parseOscColor("rgb:12/34/56"))
        for (text in ["rgb:0/1", "rgb:12345/0/0", "#abcd", "red", "rgb:g/0/0"])
            assertEquals(None, parseOscColor(text))
    }

    @Test
    fun batchedQueriesObserveEveryPriorSetAndPreservePaletteReferences() {
        val terminal = Terminal(8L, 2L)
        terminal.feed("\u001b[31mX\u001b[38;2;1;2;3mY".toByteArray())
        val old = terminal.reading
        val update = terminal.feed("\u001b]4;1;rgb:1/2/3;1;?;2;#abc;2;?\u0007".toByteArray())
        assertTrue(update.damage.paletteChanged)
        assertEquals(old.textRevision, terminal.reading.textRevision)
        assertEquals(old.screenRevision, terminal.reading.screenRevision)
        assertEquals("\u001b]4;1;rgb:1111/2222/3333\u001b\\", colorResponse(update, 0L))
        assertEquals("\u001b]4;2;rgb:a000/b000/c000\u001b\\", colorResponse(update, 1L))
        assertEquals(
            TerminalColor.Indexed(1),
            terminal.reading.lines(0L, 1L)[0L].cells[0L].style.foreground
        )
        assertEquals(
            TerminalColor.Rgb(1, 2, 3),
            terminal.reading.lines(0L, 1L)[0L].cells[1L].style.foreground
        )
        assertTrue(old.colors.palette[1L] != terminal.reading.colors.palette[1L])
        val invalid = terminal.feed("\u001b]4;-1;rgb:0/0/0;256;?;1;invalid\u0007".toByteArray())
        assertEquals(0L, invalid.effects.size)
        assertTrue(!invalid.changed)
    }

    @Test
    fun hostThemeChangesPreserveOverridesAndResetsUseTheCurrentTheme() {
        val terminal = Terminal(8L, 2L)
        terminal
            .feed(
                "\u001b]10;rgb:a/b/c;rgb:1/2/3;rgb:d/e/f\u0007\u001b]4;7;rgb:4/5/6\u0007"
                    .toByteArray()
            )
        val theme = TerminalColors(
            foreground = TerminalRgb(10, 20, 30),
            background = TerminalRgb(40, 50, 60), cursor = TerminalRgb(70, 80, 90)
        )
        terminal.setColors(theme)
        val query = terminal.feed("\u001b]10;?;?;?\u001b\\".toByteArray())
        assertEquals("\u001b]10;rgb:aaaa/bbbb/cccc\u001b\\", colorResponse(query, 0L))
        assertEquals("\u001b]11;rgb:1111/2222/3333\u001b\\", colorResponse(query, 1L))
        assertEquals("\u001b]12;rgb:dddd/eeee/ffff\u001b\\", colorResponse(query, 2L))
        terminal
            .feed(
                "\u001b]110\u0007\u001b]111\u0007\u001b]112\u0007\u001b]104;7\u0007".toByteArray()
            )
        assertEquals(theme.foreground, terminal.reading.colors.foreground)
        assertEquals(theme.background, terminal.reading.colors.background)
        assertEquals(theme.cursor, terminal.reading.colors.cursor)
        assertEquals(theme.palette[7L], terminal.reading.colors.palette[7L])
        terminal.feed("\u001b]4;1;rgb:0/0/0;2;rgb:0/0/0\u0007\u001b]104\u0007".toByteArray())
        assertEquals(theme.palette[1L], terminal.reading.colors.palette[1L])
        assertEquals(theme.palette[2L], terminal.reading.colors.palette[2L])
    }

    @Test
    fun frozenColorsRemainImmutableWhileQueriesSeePendingOverrides() {
        val terminal = Terminal(8L, 2L)
        val previous = terminal.reading
        terminal.feed("\u001b[?2026h".toByteArray())
        val update = terminal.feed("\u001b]11;rgb:1/2/3\u0007\u001b]11;?\u0007".toByteArray())
        assertTrue(terminal.reading === previous)
        assertTrue(!update.changed)
        assertEquals("\u001b]11;rgb:1111/2222/3333\u001b\\", colorResponse(update, 0L))
        val released = terminal.releaseSynchronizedOutput()
        assertTrue(released.damage.paletteChanged)
        assertEquals(TerminalRgb(0x1111, 0x2222, 0x3333), terminal.reading.colors.background)
        assertTrue(previous.colors.background != terminal.reading.colors.background)
    }

    @Test
    fun hostPaletteIsCopiedAndResetClearsApplicationOverrides() {
        val palette = defaultTerminalPalette().toMutableArray()
        val theme = TerminalColors(palette)
        val original = theme.palette[1L]
        palette[1L] = TerminalRgb(1, 2, 3)
        assertEquals(original, theme.palette[1L])
        val terminal = Terminal(8L, 2L, colors = theme)
        terminal.feed("\u001b]4;1;rgb:0/0/0\u0007\u001bc".toByteArray())
        assertEquals(original, terminal.reading.colors.palette[1L])
        assertFailsWith<IllegalArgumentException> {
            val invalid = TerminalColors(foreground = TerminalRgb(-1, 0, 0))
            Unit
        }
    }
}

private fun colorResponse(update: TerminalUpdate, index: Long): String = when (update.effects[index]
) {
    case Reply(val bytes) -> String.fromUtf8(bytes)
    case _ -> throw IllegalStateException(Some("expected color reply"))
}
