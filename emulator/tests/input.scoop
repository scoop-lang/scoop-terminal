package scoop.terminal.emulator

import scoop.test.*

@Test
private class InputProtocolTest {
    @Test
    fun controlAliasesAndTraditionalModifiedKeys() {
        val terminal = Terminal(8L, 3L)
        val aliases: Array<Char> = ['2', '3', '4', '5', '6', '7', '8', '-', '/']
        val codes: Array<Int> = [0, 27, 28, 29, 30, 31, 127, 31, 127]
        for (index in 0L..<aliases.size) {
            val bytes = terminal
                .encodeInput(
                    TerminalInput
                        .Key(
                            TerminalKey.Character(aliases[index]), TerminalModifiers(control = true)
                        )
                )
            assertEquals(1L, bytes.size)
            assertEquals(codes[index].toByte(), bytes[0L])
        }
        assertEquals(
            "\u001b[1;6A",
            key(terminal, TerminalKey.Up, TerminalModifiers(shift = true, control = true))
        )
        assertEquals(
            "\u001b[24;3~",
            key(terminal, TerminalKey.Function(12), TerminalModifiers(alt = true))
        )
        assertEquals("\r", key(terminal, TerminalKey.Enter, TerminalModifiers(shift = true)))
        assertEquals(
            "\u0008",
            key(terminal, TerminalKey.Backspace, TerminalModifiers(control = true))
        )
        terminal.feed("\u001b=\u001b[20h".toByteArray())
        assertEquals("\u001bOp", key(terminal, TerminalKey.Keypad('0')))
        assertEquals("\u001bOM", key(terminal, TerminalKey.Keypad('\r')))
        assertEquals("\r\n", key(terminal, TerminalKey.Enter))
        terminal.feed("\u001b>".toByteArray())
        assertEquals("0", key(terminal, TerminalKey.Keypad('0')))
    }

    @Test
    fun legacyMouseEmitsRawBytesWithItsOwnCoordinateLimit() {
        val terminal = Terminal(300L, 240L)
        terminal.feed("\u001b[?1000h".toByteArray())
        assertTrue(terminal.mouseReporting)
        assertTrue(terminal.reading.mouseReporting)
        val press = TerminalMouse(TerminalMouseAction.Press, TerminalMouseButton.Left, 222L, 100L)
        val bytes = terminal.encodeInput(TerminalInput.Mouse(press))
        assertEquals(6L, bytes.size)
        assertEquals(133.toByte(), bytes[4L])
        assertEquals(255.toByte(), bytes[5L])
        assertEquals(0L, terminal.encodeInput(TerminalInput.Mouse(press.{row: 223L})).size)
        val release = press.{
            action: TerminalMouseAction.Release,
            modifiers: TerminalModifiers(control = true)
        }
        assertEquals(51.toByte(), terminal.encodeInput(TerminalInput.Mouse(release))[3L])
        terminal.feed("\u001b[?1006h".toByteArray())
        assertEquals("\u001b[<0;101;224M", mouse(terminal, press.{row: 223L}))
        assertEquals("\u001b[<16;101;223m", mouse(terminal, release))
    }

    @Test
    fun trackingAndEncodingAreIndependentAndX10OnlyReportsPresses() {
        val terminal = Terminal(8L, 3L)
        val event = TerminalMouse(
            TerminalMouseAction.Press, TerminalMouseButton.Right, 1L, 2L,
            TerminalModifiers(shift = true, alt = true, control = true)
        )
        terminal.feed("\u001b[?9h".toByteArray())
        assertEquals(34.toByte(), terminal.encodeInput(TerminalInput.Mouse(event))[3L])
        assertEquals("", mouse(terminal, event.{action: TerminalMouseAction.Release}))
        terminal.feed("\u001b[?1002;1006h".toByteArray())
        assertEquals("\u001b[<62;3;2M", mouse(terminal, event.{action: TerminalMouseAction.Move}))
        assertEquals(
            "",
            mouse(
                terminal,
                event.{action: TerminalMouseAction.Move, button: TerminalMouseButton.NonePressed}
            )
        )
        terminal.feed("\u001b[?1003h\u001b[?1002l".toByteArray())
        assertEquals(
            "\u001b[<63;3;2M",
            mouse(
                terminal,
                event.{action: TerminalMouseAction.Move, button: TerminalMouseButton.NonePressed}
            )
        )
        terminal.feed("\u001b[?1003l".toByteArray())
        assertTrue(!terminal.mouseReporting)
        assertEquals("", mouse(terminal, event))
    }

    @Test
    fun pixelMouseUsesAcceptedDevicePixelsAndRequiresAPosition() {
        val terminal = Terminal(8L, 3L)
        terminal.feed("\u001b[?1000;1016h".toByteArray())
        val event = TerminalMouse(TerminalMouseAction.Press, TerminalMouseButton.Left, 1L, 2L)
        assertEquals("", mouse(terminal, event))
        assertEquals(
            "\u001b[<0;49;65M",
            mouse(terminal, event.{pixels: Some(TerminalPixelPosition(48L, 64L))})
        )
        assertEquals("", mouse(terminal, event.{pixels: Some(TerminalPixelPosition(-1L, 64L))}))
        terminal.feed("\u001b[?1006h\u001b[?1016l".toByteArray())
        assertEquals("\u001b[<0;3;2M", mouse(terminal, event))
    }

    @Test
    fun horizontalWheelIsPressOnlyAndSoftResetClearsInputModes() {
        val terminal = Terminal(8L, 3L)
        terminal.feed("\u001b[?1000;1006;1004;2004h".toByteArray())
        val event = TerminalMouse(TerminalMouseAction.Press, TerminalMouseButton.WheelLeft, 1L, 2L)
        assertEquals("\u001b[<66;3;2M", mouse(terminal, event))
        assertEquals(
            "\u001b[<67;3;2M",
            mouse(terminal, event.{button: TerminalMouseButton.WheelRight})
        )
        assertEquals("", mouse(terminal, event.{action: TerminalMouseAction.Release}))
        assertEquals("\u001b[I", String.fromUtf8(terminal.encodeInput(TerminalInput.Focus(true))))
        terminal.feed("\u001b[!p".toByteArray())
        assertEquals("", mouse(terminal, event))
        assertEquals("", String.fromUtf8(terminal.encodeInput(TerminalInput.Focus(true))))
        assertEquals("paste", String.fromUtf8(terminal.encodeInput(TerminalInput.Paste("paste"))))
    }
}

private fun key(
    terminal: Terminal,
    value: TerminalKey,
    modifiers: TerminalModifiers = TerminalModifiers()
): String = String.fromUtf8(terminal.encodeInput(TerminalInput.Key(value, modifiers)))

private fun mouse(terminal: Terminal, value: TerminalMouse): String = String
    .fromUtf8(terminal.encodeInput(TerminalInput.Mouse(value)))
