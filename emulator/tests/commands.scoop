package scoop.terminal.emulator

import scoop.test.*

@Test
private class ShellCommandTest {
    @Test
    fun migratingBoundaryHandlesAdvancesCommandVersionAndPreservesOldReadings() {
        Terminal(16L, 3L)
            .use { terminal ->
                terminal
                    .feed(
                        "\u001b]133;A\u0007$ old\u001b]133;D;0\u0007\r\n\u001b]133;A\u0007$ next"
                            .toByteArray()
                    )
                val before = terminal.reading
                val block = before.commands(1L, 1L)[0L]
                assertEquals(Some(TerminalPosition(1L, 0L)), before.resolve(block.prompt!!))
                terminal.feed("\u001b[2;1H\u001b[@".toByteArray())
                val after = terminal.reading
                assertTrue(after.commandVersion > before.commandVersion)
                assertEquals(
                    Some(TerminalPosition(1L, 1L)),
                    after.resolve(after.command(block.id)!!.prompt!!)
                )
                assertEquals(
                    Some(TerminalPosition(1L, 0L)),
                    before.resolve(before.command(block.id)!!.prompt!!)
                )
            }
    }

    @Test
    fun erasedPromptRedrawKeepsItsIdentityAcrossFeedBoundaries() {
        val bytes = "\r\u001b[2K\u001b]133;A\u0007$ ".toByteArray()
        for (split in 0L..bytes.size) {
            val terminal = Terminal(8L, 2L)
            terminal.feed("\u001b]133;A\u0007$ ".toByteArray())
            val id = terminal.reading.commands(0L, 1L)[0L].id
            terminal.feed(Array<Byte>(split) { i -> bytes[i] })
            terminal.feed(Array<Byte>(bytes.size - split) { i -> bytes[split + i] })
            assertEquals(1L, terminal.reading.commandCount)
            assertEquals(id, terminal.reading.commands(0L, 1L)[0L].id)
            assertFalse(terminal.reading.commands(0L, 1L)[0L].separator)
        }
    }

    @Test
    fun splitMarkersCaptureRangesStatusAndCwdWithoutAddingText() {
        val stream =
            "\u001b]7;file://remote/repo\u0007\u001b]133;A\u0007$ \u001b]133;B\u0007echo hi\r\n\u001b]133;C\u0007hi\r\n\u001b]133;D;0\u001b\\\u001b]133;A\u0007$ "
        val bytes = stream.toByteArray()
        for (split in 0L..bytes.size) {
            val terminal = Terminal(16L, 4L)
            terminal.feed(Array<Byte>(split) { i -> bytes[i] })
            terminal.feed(Array<Byte>(bytes.size - split) { i -> bytes[split + i] })
            val reading = terminal.reading
            assertEquals(2L, reading.commandCount)
            val first = reading.commands(0L, 1L)[0L]
            assertEquals(TerminalCommandState.Finished, first.state)
            assertEquals(Some(0), first.exitStatus)
            assertEquals(Some("remote"), first.workingDirectory?.host)
            assertFalse(first.separator)
            assertEquals(Some("$ echo hi\nhi\n"), reading.text(first.range!!))
            assertEquals(
                Some("echo hi\n"),
                reading.text(TerminalRange(first.input!!, first.output!!))
            )
            val next = reading.commands(1L, 1L)[0L]
            assertTrue(next.separator)
            assertEquals(TerminalCommandState.Editing, next.state)
            assertEquals(next.id, reading.commandAt(next.prompt!!)!!.id)
            assertEquals(1L, reading.commandsIn(first.range!!).size)
            assertEquals(TerminalCursor(2L, 2L, true), reading.cursor)
        }
    }

    @Test
    fun redrawSecondaryPromptsEmptyCommandsAndUnknownExitStatuses() {
        val terminal = Terminal(12L, 5L)
        terminal
            .feed(
                "\u001b]133;A\u0007$ \r\u001b]133;A;unknown=yes\u0007$ \u001b]133;B\u0007\r\n\u001b]133;A;k=s\u0007> \r\n\u001b]133;D\u0007\u001b]133;D\u0007"
                    .toByteArray()
            )
        assertEquals(1L, terminal.reading.commandCount)
        val block = terminal.reading.commands(0L, 1L)[0L]
        assertEquals(TerminalCommandState.Finished, block.state)
        assertEquals(None, block.exitStatus)
        terminal
            .feed(
                "\u001b]133;A\u0007$ \u001b]133;B\u0007stop\r\n\u001b]133;C\u0007\u001b]133;D;130\u0007"
                    .toByteArray()
            )
        assertEquals(Some(130), terminal.reading.commands(1L, 1L)[0L].exitStatus)
    }

    @Test
    fun missingAndOrphanMarkersNeverInventACompleteSuccessfulCommand() {
        val terminal = Terminal(10L, 5L)
        terminal
            .feed(
                "\u001b]133;D\u0007\u001b]133;A\u0007$ a\r\n\u001b]133;C\u0007output\r\n\u001b]133;A\u0007nested$ "
                    .toByteArray()
            )
        val blocks = terminal.reading.commands(0L, terminal.reading.commandCount)
        assertEquals(3L, blocks.size)
        assertEquals(TerminalCommandState.Incomplete, blocks[0L].state)
        assertEquals(None, blocks[0L].prompt)
        assertEquals(None, blocks[0L].exitStatus)
        assertEquals(TerminalCommandState.Incomplete, blocks[1L].state)
        terminal.finishOutput()
        assertEquals(TerminalCommandState.Incomplete, terminal.reading.commands(2L, 1L)[0L].state)
    }

    @Test
    fun pendingWrapReflowAndErasureMoveOrRetirePromptMarkers() {
        val terminal = Terminal(4L, 2L, historyLimit = 0L)
        terminal.feed("abcd\u001b]133;A\u0007$ ".toByteArray())
        val block = terminal.reading.commands(0L, 1L)[0L]
        assertEquals(Some(TerminalPosition(1L, 0L)), terminal.reading.resolve(block.prompt!!))
        terminal.resize(8L, 2L)
        val moved = terminal.reading.command(block.id)!!
        assertEquals(Some(TerminalPosition(0L, 4L)), terminal.reading.resolve(moved.prompt!!))
        terminal.feed("\u001b[H\u001b[2J".toByteArray())
        assertEquals(0L, terminal.reading.commandCount)
        val single = Terminal(4L, 1L, historyLimit = 0L)
        single.feed("abcd\u001b]133;A\u0007$".toByteArray())
        assertEquals(
            Some(TerminalPosition(0L, 0L)),
            single.reading.resolve(single.reading.commands(0L, 1L)[0L].prompt!!)
        )
    }

    @Test
    fun frozenReadingsAndAlternateBuffersKeepTheirOwnCommandMetadata() {
        val terminal = Terminal(8L, 3L)
        terminal.feed("\u001b]133;A\u0007$ a\r\n\u001b]133;C\u0007".toByteArray())
        val original = terminal.reading
        terminal.feed("\u001b[?2026h\u001b]133;D;3\u0007\u001b]133;A\u0007$ ".toByteArray())
        assertEquals(1L, terminal.reading.commandCount)
        assertEquals(TerminalCommandState.Running, terminal.reading.commands(0L, 1L)[0L].state)
        terminal.releaseSynchronizedOutput()
        assertEquals(2L, terminal.reading.commandCount)
        terminal.feed("\u001b[?1049h\u001b]133;A\u0007alt".toByteArray())
        assertEquals(1L, terminal.reading.commandCount)
        assertFalse(terminal.reading.commands(0L, 1L)[0L].separator)
        terminal.feed("\u001b[?1049l".toByteArray())
        assertEquals(2L, terminal.reading.commandCount)
        terminal.feed("\u001bc".toByteArray())
        assertEquals(0L, terminal.reading.commandCount)
        assertEquals(1L, original.commandCount)
        assertEquals(TerminalCommandState.Running, original.commands(0L, 1L)[0L].state)
    }

    @Test
    fun retentionAndMetadataLimitsReleaseOldMarkersAndReportRejection() {
        val terminal = Terminal(8L, 3L, commandLimits = TerminalCommandLimits(maxBlocks = 2L))
        for (index in 0L..<6L)
            terminal.feed("\u001b]133;A\u0007$\r\n\u001b]133;D;0\u0007".toByteArray())
        assertEquals(2L, terminal.reading.commandCount)
        assertTrue(terminal.reading.commands(0L, 1L)[0L].id > 1L)
        val limited = Terminal(8L, 2L, commandLimits = TerminalCommandLimits(maxBytes = 1L))
        val rejected = limited.feed("\u001b]133;A\u0007$".toByteArray())
        assertEquals(0L, limited.reading.commandCount)
        assertEquals(1L, rejected.effects.size)
        terminal.feed("\u001b[2J\u001b[3J".toByteArray())
        assertEquals(0L, terminal.reading.commandCount)
    }
}
