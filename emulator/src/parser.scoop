package scoop.terminal.emulator

/** Limits apply to encoded OSC payload bytes; graphics handlers enforce their own budgets. */
public struct TerminalParserLimits(
    val oscBytes: Long = 65536L,
    val clipboardBytes: Long = 1398108L
)

internal interface VtActions {
    fun print(character: Char)
    fun control(code: Int)
    fun escape(intermediate: Int, final: Int)
    fun csi(command: VtCsi)
    fun osc(selector: Int, bytes: Array<Byte>)
    fun startString(kind: VtStringKind): VtStringSink?
}

internal enum VtStringKind {
    Dcs(VtCsi), Apc
}

/** A handler consumes incrementally and must release partial state when cancelled. */
internal interface VtStringSink {
    fun push(byte: Int)
    fun finish()
    fun cancel()
}

internal struct VtCsi(
    val prefix: Int,
    val intermediate: Int,
    val final: Int,
    val arguments: Array<Int>,
    val separators: Array<Int>
) {
    fun argument(index: Long, defaultValue: Int): Int = if (index <
        0L ||
        index >=
        arguments.size ||
        arguments[index] <
        0
    )
        defaultValue
    else
        arguments[index]

    fun count(index: Long = 0L): Int {
        val value = argument(index, 1)
        return if (value == 0) 1 else value
    }
}

private enum VtState {
    Ground, Escape, EscapeIgnore, Csi, CsiIgnore, Dcs, DcsIgnore,
    Osc, OscEscape, StringPayload, StringEscape, StringIgnore, IgnoreEscape
}

internal class VtParser(
    private val actions: VtActions,
    private val limits: TerminalParserLimits = TerminalParserLimits()
) {
    private var state = VtState.Ground
    private val text = VtUtf8 { character -> actions.print(character) }
    private var intermediate = 0
    private var prefix = 0
    private var field = -1
    private val arguments = ArrayList<Int>()
    private val separators = ArrayList<Int>()
    private var oscSelector = -1
    private var oscBody = false
    private var oscValid = true
    private val oscPayload = ArrayList<Byte>()
    private var sink: VtStringSink? = None

    init {
        if (limits.oscBytes < 0L || limits.clipboardBytes < 0L)
            throw IllegalArgumentException(Some("negative terminal parser limit"))
    }

    fun feed(bytes: List<Byte>) {
        for (byte in bytes)
            advance(byte.toInt() and 0xff)
    }

    fun finish() {
        text.finish()
        cancelString()
        state = VtState.Ground
    }

    private fun cancelString() {
        sink?.cancel()
        sink = None
        oscPayload.clear()
    }

    private fun advance(byte: Int) {
        if (state == VtState.Ground) {
            if (byte >= 0x20 && byte != 0x7f) {
                // This is UTF-8 mode: continuation bytes must never be interpreted as C1.
                text.push(byte)
            } else {
                text.finish()
                if (byte == 0x1b) startEscape() else if (byte != 0x7f) actions.control(byte)
            }
            return
        }
        if (byte == 0x18 || byte == 0x1a) {
            cancelString()
            state = VtState.Ground
            return
        }
        when (state) {
            case Osc -> {
                if (byte == 0x07)
                    finishOsc()
                else if (byte == 0x1b)
                    state = VtState.OscEscape
                else if (byte >= 0x20 && byte != 0x7f) readOsc(byte)
                return
            }

            case OscEscape -> {
                if (byte == '\\'.code)
                    finishOsc()
                else {
                    oscValid = false
                    oscPayload.clear()
                    state = if (byte == 0x1b) VtState.OscEscape else VtState.Osc
                    if (byte == 7) finishOsc()
                }
                return
            }

            case StringPayload -> {
                if (byte == 0x1b) state = VtState.StringEscape else sink?.push(byte)
                return
            }

            case StringEscape -> {
                if (byte == '\\'.code) {
                    val finished = sink
                    sink = None
                    state = VtState.Ground
                    finished?.finish()
                } else {
                    cancelString()
                    state = if (byte == 0x1b) VtState.IgnoreEscape else VtState.StringIgnore
                }
                return
            }

            case StringIgnore -> {
                if (byte == 0x1b) state = VtState.IgnoreEscape
                return
            }

            case IgnoreEscape -> {
                if (byte == '\\'.code)
                    state = VtState.Ground
                else if (byte != 0x1b) state = VtState.StringIgnore
                return
            }

            case _ -> {}
        }
        if (byte == 0x1b) {
            startEscape()
        } else if (byte < 0x20) {
            if (state != VtState.Dcs && state != VtState.DcsIgnore) actions.control(byte)
        } else if (byte < 0x7f) {
            when (state) {
                case Escape -> readEscape(byte)
                case EscapeIgnore -> if (byte >= 0x30) state = VtState.Ground
                case Csi -> readHeader(byte, false)
                case Dcs -> readHeader(byte, true)
                case CsiIgnore -> if (byte >= 0x40) state = VtState.Ground
                case DcsIgnore -> if (byte >= 0x40) state = VtState.StringIgnore
                case _ -> {}
            }
        }
    }

    private fun startEscape() {
        intermediate = 0
        state = VtState.Escape
    }

    private fun startHeader(dcs: Boolean) {
        prefix = 0
        field = -1
        arguments.clear()
        separators.clear()
        state = if (dcs) VtState.Dcs else VtState.Csi
    }

    private fun readEscape(byte: Int) {
        if (byte < 0x30) {
            if (intermediate == 0) intermediate = byte else state = VtState.EscapeIgnore
        } else if (intermediate != 0) {
            actions.escape(intermediate, byte)
            state = VtState.Ground
        } else {
            when (byte) {
                case 0x5b -> startHeader(false)
                case 0x50 -> startHeader(true)

                case 0x5d -> {
                    oscSelector = -1
                    oscBody = false
                    oscValid = true
                    oscPayload.clear()
                    state = VtState.Osc
                }

                case 0x5f -> {
                    sink = actions.startString(VtStringKind.Apc)
                    state = VtState.StringPayload
                }

                case 0x58 -> state = VtState.StringIgnore
                case 0x5e -> state = VtState.StringIgnore

                case _ -> {
                    actions.escape(0, byte)
                    state = VtState.Ground
                }
            }
        }
    }

    private fun readHeader(byte: Int, dcs: Boolean) {
        if (byte >= 0x40) {
            arguments.add(field)
            val header = VtCsi(
                prefix,
                intermediate,
                byte,
                arguments.toArray(),
                separators.toArray()
            )
            if (dcs) {
                sink = actions.startString(VtStringKind.Dcs(header))
                state = VtState.StringPayload
            } else {
                state = VtState.Ground
                actions.csi(header)
            }
        } else if (byte < 0x30 && intermediate == 0) {
            intermediate = byte
        } else if (intermediate == 0 && byte >= 0x30 && byte <= 0x39) {
            val digit = byte - 0x30
            val previous = if (field < 0) 0 else field
            field = if (previous > (Int.MAX_VALUE - digit) / 10)
                Int.MAX_VALUE
            else
                previous * 10 + digit
        } else if (intermediate == 0 && (byte == 0x3a || byte == 0x3b) && arguments.size < 31L) {
            arguments.add(field)
            separators.add(byte)
            field = -1
        } else if (byte >=
            0x3c &&
            byte <=
            0x3f &&
            prefix ==
            0 &&
            intermediate ==
            0 &&
            field <
            0 &&
            arguments.size ==
            0L
        ) {
            prefix = byte
        } else {
            state = if (dcs) VtState.DcsIgnore else VtState.CsiIgnore
        }
    }

    private fun readOsc(byte: Int) {
        if (!oscValid) return
        if (!oscBody) {
            if (byte == 0x3b && oscSelector >= 0)
                oscBody = true
            else if (byte >= 0x30 && byte <= 0x39) {
                val value = if (oscSelector < 0) 0 else oscSelector
                val digit = byte - 0x30
                if (value > (Int.MAX_VALUE - digit) / 10)
                    oscValid = false
                else
                    oscSelector = value * 10 + digit
            } else
                oscValid = false
        } else {
            val limit = if (oscSelector == 52) limits.clipboardBytes else limits.oscBytes
            if (oscPayload.size == limit) {
                oscValid = false
                oscPayload.clear()
            } else
                oscPayload.add(byte.toByte())
        }
    }

    private fun finishOsc() {
        state = VtState.Ground
        if (oscValid && oscSelector >= 0) actions.osc(oscSelector, oscPayload.toArray())
        oscPayload.clear()
    }
}
