package scoop.terminal.emulator

internal class TerminalModes {
    var horizontalMargins = false
    var autoWrap = true
    var insert = false
    var lineFeedNewLine = false
    var applicationCursor = false
    var applicationKeypad = false
    var cursorVisible = true
    var cursorShape = TerminalCursorShape.Block
    var cursorBlink = true
    var mouseTracking = 0
    var sgrMouse = false
    var pixelMouse = false
    var focusEvents = false
    var bracketedPaste = false
}

internal fun lineCharacter(character: Char): Char = when (character) {
    case '`' -> '◆'
    case 'a' -> '▒'
    case 'f' -> '°'
    case 'g' -> '±'
    case 'j' -> '┘'
    case 'k' -> '┐'
    case 'l' -> '┌'
    case 'm' -> '└'
    case 'n' -> '┼'
    case 'o' -> '⎺'
    case 'p' -> '⎻'
    case 'q' -> '─'
    case 'r' -> '⎼'
    case 's' -> '⎽'
    case 't' -> '├'
    case 'u' -> '┤'
    case 'v' -> '┴'
    case 'w' -> '┬'
    case 'x' -> '│'
    case 'y' -> '≤'
    case 'z' -> '≥'
    case '{' -> 'π'
    case '|' -> '≠'
    case '}' -> '£'
    case '~' -> '·'
    case _ -> character
}
