package scoop.terminal.emulator

internal class ScreenRow(
    val id: Long,
    columns: Long,
    style: TerminalStyle,
    private val changes: ScreenChanges
) {
    private var cells = MutableArray<TerminalCell>(columns) { TerminalCell(style = style) }
    private var wrapped = false
    private var version = 0L
    private var published: TerminalLine? = None
    private var publishedCells: Array<TerminalCell>? = None
    private var identity = LogicalLine(id)
    private var offset = 0L
    private var used = if (style == TerminalStyle()) 0L else columns
    val logical: LogicalLine get() = identity
    val logicalOffset: Long get() = offset
    val usedColumns: Long get() = used
    val logicalLength: Long get() = logicalColumn(used)
    val columns: Long get() = cells.size
    var softWrapped: Boolean
        get() = wrapped
        set(value) {
            if (wrapped != value) {
                wrapped = value
                invalidate()
            }
        }

    operator fun get(column: Long): TerminalCell = cells[column]

    fun snapshot(): TerminalLine {
        when (published) {
            case Some(val line) -> if (line.textVersion == identity.version) return line
            case None -> {}
        }
        val content = when (publishedCells) {
            case Some(val content) -> content

            case None -> {
                val content = cells.toArray()
                publishedCells = Some(content)
                content
            }
        }
        val line = TerminalLine(
            id,
            content,
            softWrapped,
            version,
            identity.id,
            offset,
            used,
            identity.version
        )
        published = Some(line)
        return line
    }

    private fun invalidate() {
        published = None
        publishedCells = None
        version += 1L
        identity.version += 1L
        changes.pending = true
    }

    fun rebase(line: LogicalLine, start: Long) {
        if (identity === line && offset == start) return
        identity = line
        offset = start
        published = None
        changes.pending = true
    }

    fun logicalColumn(column: Long): Long {
        var visual = 0L
        var logical = 0L
        val end = clamp(column, 0L, cells.size)
        while (visual < end) {
            val cell = cells[visual]
            val width = if (cell.width == 0L) 1L else cell.width
            if (visual + width > end) return logical + end - visual
            logical += if (cell.width == 0L) 1L else cell.logicalWidth
            visual += width
        }
        return logical
    }

    fun visualColumn(column: Long): Long {
        var visual = 0L
        var logical = 0L
        while (visual < cells.size && logical < column) {
            val cell = cells[visual]
            val width = if (cell.width == 0L) 1L else cell.width
            val length = if (cell.width == 0L) 1L else cell.logicalWidth
            if (logical + length > column) return visual + clamp(column - logical, 0L, width)
            logical += length
            visual += width
        }
        return visual
    }

    fun put(
        column: Long,
        text: String,
        width: Long,
        style: TerminalStyle,
        intrinsicWidth: Long = 0L
    ) {
        putCell(column, TerminalCell(text, width, style, intrinsicWidth))
    }

    fun putCell(column: Long, cell: TerminalCell) {
        val continuation = TerminalCell(width = 0L, style = cell.style)
        val extended = column + cell.width > used
        if (extended) used = column + cell.width
        if (cells[column] == cell && (cell.width != 2L || cells[column + 1L] == continuation)) {
            if (extended) invalidate()
            return
        }
        clearGlyph(column, cell.style)
        if (cell.width == 2L) {
            clearGlyph(column + 1L, cell.style)
            cells[column + 1L] = continuation
        }
        cells[column] = cell
        trim()
        invalidate()
    }

    private fun trim() {
        val blank = TerminalCell()
        while (used > 0L && cells[used - 1L] == blank)
            used -= 1L
    }

    fun erase(start: Long, end: Long, style: TerminalStyle) {
        if (start >= end) return
        val left = if (cells[start].width == 0L) start - 1L else start
        val right = if (end < cells.size && cells[end].width == 0L) end + 1L else end
        val blank = TerminalCell(style = style)
        if (style != TerminalStyle() && right > used) used = right
        for (index in left..<right) {
            if (cells[index] != blank) {
                cells[index] = blank
                invalidate()
            }
        }
        trim()
        if (right == cells.size) softWrapped = false
    }

    fun shift(start: Long, amount: Long, insert: Boolean, style: TerminalStyle) {
        val count = clamp(amount, 0L, cells.size - start)
        if (count == 0L) return
        val blank = TerminalCell(style = style)
        if (insert) {
            var index = cells.size - 1L
            while (index >= start + count) {
                cells[index] = cells[index - count]
                index -= 1L
            }
            for (column in start..<start + count)
                cells[column] = blank
        } else {
            for (column in start..<cells.size - count)
                cells[column] = cells[column + count]
            for (column in cells.size - count..<cells.size)
                cells[column] = blank
        }
        repair(style)
        used = cells.size
        trim()
        softWrapped = false
        invalidate()
    }

    fun resize(columns: Long, style: TerminalStyle) {
        if (columns == cells.size) return
        val previous = cells
        val blank = TerminalCell(style = style)
        cells = MutableArray<TerminalCell>(columns) { index ->
            if (index < previous.size) previous[index] else blank
        }
        repair(style)
        used = cells.size
        trim()
        softWrapped = false
        invalidate()
    }

    private fun clearGlyph(column: Long, style: TerminalStyle) {
        val blank = TerminalCell(style = style)
        when (cells[column].width) {
            case 0L -> cells[column - 1L] = blank
            case 2L -> cells[column + 1L] = blank
            case _ -> {}
        }
        cells[column] = blank
    }

    private fun repair(style: TerminalStyle) {
        val blank = TerminalCell(style = style)
        var index = 0L
        while (index < cells.size) {
            when (cells[index].width) {
                case 2L -> {
                    if (index + 1L < cells.size && cells[index + 1L].width == 0L)
                        index += 1L
                    else
                        cells[index] = blank
                }

                case 0L -> cells[index] = blank
                case _ -> {}
            }
            index += 1L
        }
    }
}
