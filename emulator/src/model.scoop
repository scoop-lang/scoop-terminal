package scoop.terminal.emulator

/** A color before the host applies its terminal palette. */
public enum TerminalColor {
    Default, Indexed(Int), Rgb(Int, Int, Int)
}

public enum TerminalUnderline {
    None, Single, Double, Curly, Dotted, Dashed
}

/** Rendition information shared by both columns of a wide glyph. */
public struct TerminalStyle(
    val foreground: TerminalColor = TerminalColor.Default,
    val background: TerminalColor = TerminalColor.Default,
    val flags: Int = 0,
    val underline: TerminalUnderline = TerminalUnderline.None,
    val underlineColor: TerminalColor = TerminalColor.Default
) {
    public val bold: Boolean get() = (flags and 1) != 0
    public val faint: Boolean get() = (flags and 2) != 0
    public val italic: Boolean get() = (flags and 4) != 0
    public val underlined: Boolean get() = underlineStyle != TerminalUnderline.None
    public val underlineStyle: TerminalUnderline
        get() = if (underline == TerminalUnderline.None && (flags and 8) != 0)
            TerminalUnderline.Single
        else
            underline
    public val blink: Boolean get() = (flags and 16) != 0
    public val inverse: Boolean get() = (flags and 32) != 0
    public val concealed: Boolean get() = (flags and 64) != 0
    public val struck: Boolean get() = (flags and 128) != 0
}

/** Width zero is the trailing column of a wide glyph. Empty text otherwise denotes a blank. */
public struct TerminalCell(
    val text: String = "",
    val width: Long = 1L,
    val style: TerminalStyle = TerminalStyle(),
    val intrinsicWidth: Long = 0L,
    val dottedCircle: Boolean = false
) {
    /** A narrow-window placeholder retains the original grapheme and its logical width. */
    public val logicalWidth: Long get() = if (intrinsicWidth > 0L) intrinsicWidth else width
    public val displayText: String
        get() = if (logicalWidth > width) "�" else if (dottedCircle) "◌" + text else text
}

/** A physical row, with identity retained when the row moves through scrollback. */
public struct TerminalLine(
    val id: Long,
    val cells: Array<TerminalCell>,
    val softWrapped: Boolean,
    val contentVersion: Long = 0L,
    val logicalLineId: Long = 0L,
    val logicalOffset: Long = 0L,
    val usedColumns: Long = 0L,
    val textVersion: Long = 0L,
    val retainedBytes: Long = 0L
)

public enum TerminalCursorShape {
    Block, Underline, Bar
}

public struct TerminalCursor(
    val row: Long,
    val column: Long,
    val visible: Boolean,
    val shape: TerminalCursorShape = TerminalCursorShape.Block,
    val blink: Boolean = true
)

/** Effects are delivered in the same order as the output that produced them. */
public enum TerminalEffect {
    Reply(Array<Byte>), Title(String), Bell,
    ClipboardReadRequested(TerminalClipboardRead), ClipboardWriteRequested(TerminalClipboardWrite),
    WorkingDirectoryChanged(TerminalWorkingDirectory?), ProgressChanged(TerminalProgress)
}

public struct TerminalUpdate(
    val changed: Boolean,
    val effects: Array<TerminalEffect>,
    val damage: TerminalDamage = TerminalDamage(),
    val revision: Long = 0L,
    val textRevision: Long = 0L,
    val presentationVersion: Long = 0L
)

internal fun clamp(value: Long, lower: Long, upper: Long): Long = if (value < lower)
    lower
else if (value > upper) upper else value
