package scoop.terminal.emulator

import scoop.io.encoding.Base64

/** A single direct Kitty transfer; headers and protocol replies are handled by the APC sink. */
internal class ImageBase64Transfer(
    private val memory: ImageMemory,
    payloadLimit: Long = Long.MAX_VALUE
) : Closeable {
    private val payload = ImageAccumulator(
        memory,
        if (payloadLimit < memory.limits.maxEncodedBytes)
            payloadLimit
        else
            memory.limits.maxEncodedBytes
    )
    private var ended = false
    private var encoded = 0L
    val encodedBytes: Long get() = encoded
    val isClosed: Boolean get() = ended

    /** Returns owned bytes only at the final chunk; failure discards the entire transfer. */
    fun push(chunk: String, more: Boolean): ImageBytes? {
        if (ended) throw IllegalStateException(Some("image transmission is closed"))
        try {
            val size = chunk.byteLength
            if (size > memory.limits.maxEncodedBytes - encoded)
                imageFailure(TerminalImageFailure.Limit, "cumulative encoded image limit exceeded")
            encoded += size
            payload.appendOwned(decodeImageBase64(memory, chunk, more))
            if (more) return None
            ended = true
            return Some(payload.finish())
        } catch (error: Throwable) {
            close()
            throw error
        }
    }

    public override fun close() {
        ended = true
        payload.close()
    }
}

private fun decodeImageBase64(memory: ImageMemory, chunk: String, more: Boolean): ImageBytes {
    val length = chunk.byteLength
    if (length > 4096L)
        imageFailure(TerminalImageFailure.Limit, "image Base64 chunk exceeds 4096 bytes")
    if (more && length % 4L != 0L)
        imageFailure(
            TerminalImageFailure.InvalidData,
            "non-final Base64 chunk is not a multiple of four"
        )
    // The library's builder can grow to twice the decoded size and copies its final array.
    // Also cover the bounded APC byte chunk/String while the decoder borrows it.
    val maximum = (length + 3L) / 4L * 3L
    val reservation = memory.reserve(maximum * 3L + length * 2L + 1024L)
    try {
        val codec = Base64
            .Default
            .withPadding(
                if (more) Base64.PaddingOption.Absent else Base64.PaddingOption.Optional
            )
        val bytes = codec.decodeOrNone(chunk) ?:
            imageFailure(TerminalImageFailure.InvalidData, "invalid image Base64")
        reservation.resize(bytes.size + ImageBytes.overhead)
        return ImageBytes.adopt(memory, reservation, bytes)
    } catch (error: Throwable) {
        reservation.close()
        throw error
    }
}
