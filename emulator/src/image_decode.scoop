package scoop.terminal.emulator

/**
 * Synchronous CPU PNG codec, called on the model owner. Return tightly packed immutable
 * straight-alpha RGBA8 and close all native resources before returning or throwing.
 */
public interface TerminalImageDecoder {
    /** Additional peak bytes, including the returned array, native encoded copies and all work. */
    public fun peakBytes(size: TerminalImageSize, encodedBytes: Long): Long
    /** Input has passed PNG framing/CRC/dimension validation; the codec must reject incomplete pixels. */
    public fun decodePng(encoded: Array<Byte>, size: TerminalImageSize): Array<Byte>
}

internal class ImageRaster(val size: TerminalImageSize, val pixels: ImageBytes) : Closeable {
    fun retain(): ImageRaster = ImageRaster(size, pixels.retain())
    public override fun close() {
        pixels.close()
    }
}

internal fun decodeImageRgb(
    input: ImageBytes,
    width: Long,
    height: Long,
    alpha: Boolean
): ImageRaster {
    val memory = input.memory
    val size = imageSize(width, height, memory.limits)
    val bytes = input.bytes
    val components = if (alpha) 4L else 3L
    if (bytes.size != size.rgbaBytes / 4L * components)
        imageFailure(
            TerminalImageFailure.InvalidData,
            "raw image byte count differs from dimensions"
        )
    if (alpha) return ImageRaster(size, input.retain())
    val pixels = ImageBytes
        .create(memory, size.rgbaBytes) {
            Array<Byte>(size.rgbaBytes) { offset ->
                if (offset % 4L == 3L) 255.toByte() else bytes[offset / 4L * 3L + offset % 4L]
            }
        }
    return ImageRaster(size, pixels)
}

internal fun decodeImagePng(input: ImageBytes, decoder: TerminalImageDecoder?): ImageRaster {
    val memory = input.memory
    val encoded = input.bytes
    val size = inspectImagePng(encoded, memory.limits)
    val codec = decoder ?:
        imageFailure(TerminalImageFailure.Unsupported, "PNG decoder is unavailable")
    val peak = codec.peakBytes(size, encoded.size)
    if (peak < size.rgbaBytes)
        throw IllegalArgumentException(Some("PNG decoder peak must include its result pixels"))
    val reservation = memory.reserve(imageByteSum(peak, ImageBytes.overhead))
    try {
        val result = codec.decodePng(encoded, size)
        if (result.size != size.rgbaBytes)
            imageFailure(
                TerminalImageFailure.InvalidData,
                "PNG decoder returned a different pixel size"
            )
        reservation.resize(imageByteSum(result.size, ImageBytes.overhead))
        return ImageRaster(size, ImageBytes.adopt(memory, reservation, result))
    } catch (error: Throwable) {
        reservation.close()
        throw error
    }
}
