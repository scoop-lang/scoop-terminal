package scoop.terminal.emulator

internal class VtUtf8(private val emit: (Char) -> Unit) {
    private var remaining = 0
    private var scalar = 0
    private var minimum = 0x80
    private var maximum = 0xbf

    fun push(byte: Int) {
        if (remaining != 0) {
            if (byte >= minimum && byte <= maximum) {
                scalar = (scalar shl 6L) or (byte and 0x3f)
                remaining -= 1
                minimum = 0x80
                maximum = 0xbf
                if (remaining == 0) emit(scalar.toChar())
                return
            }
            finish()
        }
        if (byte < 0x80) {
            emit(byte.toChar())
        } else if (byte >= 0xc2 && byte <= 0xdf) {
            scalar = byte and 0x1f
            remaining = 1
        } else if (byte >= 0xe0 && byte <= 0xef) {
            scalar = byte and 0x0f
            remaining = 2
            if (byte == 0xe0) minimum = 0xa0
            if (byte == 0xed) maximum = 0x9f
        } else if (byte >= 0xf0 && byte <= 0xf4) {
            scalar = byte and 0x07
            remaining = 3
            if (byte == 0xf0) minimum = 0x90
            if (byte == 0xf4) maximum = 0x8f
        } else {
            emit('\uFFFD')
        }
    }

    fun finish() {
        if (remaining != 0) {
            reset()
            emit('\uFFFD')
        }
    }

    fun reset() {
        remaining = 0
        minimum = 0x80
        maximum = 0xbf
    }
}
