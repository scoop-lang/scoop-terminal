package scoop.terminal.emulator

import scoop.charset.unicodeTerminalDataVersion

public enum TerminalAmbiguousWidth {
    Narrow, Wide
}

/** An incremental VT emulator with reflowable main-screen scrollback. All access is serialized by its owner. */
public class Terminal public constructor(
    columns: Long,
    rows: Long,
    historyLimit: Long = 10000L,
    snapshotLimits: TerminalSnapshotLimits = TerminalSnapshotLimits(),
    parserLimits: TerminalParserLimits = TerminalParserLimits(),
    ambiguousWidth: TerminalAmbiguousWidth = TerminalAmbiguousWidth.Narrow
) {
    private val state = createState(columns, rows, historyLimit, parserLimits, ambiguousWidth)
    private val snapshotBudget = SnapshotBudget(snapshotLimits)

    /** Borrowed committed reading; acquire a snapshot when retaining it beyond the current use. */
    public val reading: TerminalReading get() = state.reading
    public fun snapshot(): TerminalSnapshot = snapshotBudget.acquire(state.reading)

    public val unicodeVersion: String = unicodeTerminalDataVersion()
    public val ambiguousWidth: TerminalAmbiguousWidth get() = state.ambiguousWidth

    public val columns: Long get() = state.screen.columns
    public val rows: Long get() = state.screen.rows
    public val historySize: Long get() = state.screen.historySize
    public val revision: Long get() = state.revision
    /** Version of the cells, physical rows and scrollback, independent of cursor-only output. */
    public val screenRevision: Long get() = state.screenRevision
    public val alternateScreen: Boolean get() = state.alternateScreen
    public val bufferEpoch: Long get() = state.screen.bufferEpoch
    public val mouseReporting: Boolean
        get() = state.modes.mouseTracking != 0 && state.modes.sgrMouse
    public val cursor: TerminalCursor
        get() {
            val screen = state.screen
            return TerminalCursor(screen.row, screen.column, state.modes.cursorVisible)
        }

    /** Processes output in order, retaining incomplete UTF-8, escape sequences and graphemes. */
    public fun feed(bytes: List<Byte>): TerminalUpdate = state.feed(bytes)

    /** Completes pending text when the output stream ends. */
    public fun finishOutput(): TerminalUpdate = state.finishOutput()

    /** Reflows the main screen; the alternate screen retains its two-dimensional grid semantics. */
    public fun resize(columns: Long, rows: Long, restoreHistory: Boolean = true): TerminalUpdate {
        checkSize(columns, rows)
        return if (columns != this.columns || rows != this.rows)
            state.resize(columns, rows, restoreHistory)
        else
            TerminalUpdate(false, [])
    }

    /** Reads zero-based physical rows, starting at the oldest retained scrollback row. */
    public fun lines(start: Long, count: Long): Array<TerminalLine> {
        val limit = historySize + rows
        if (start < 0L || start > limit || count < 0L || count > limit - start)
            throw IndexOutOfBoundsException()
        return state.screen.lines(start, count)
    }

    public fun findLine(id: Long): Long? = state.screen.findLine(id)

    /** Creates an anchor; wide-cell endpoints expand according to affinity. Invalid coordinates return None. */
    public fun anchorAt(
        row: Long,
        column: Long,
        affinity: TerminalAffinity = TerminalAffinity.After
    ): TerminalAnchor? = state.screen.anchorAt(row, column, affinity)

    /** Resolves retained content in the active buffer. Reset or eviction makes the anchor unavailable. */
    public fun resolve(anchor: TerminalAnchor): TerminalPosition? = state.screen.resolve(anchor)

    /** Encodes a host input using the modes active at the moment of the call. */
    public fun encodeInput(input: TerminalInput): Array<Byte> = encode(state, input)
}

private fun createState(
    columns: Long,
    rows: Long,
    historyLimit: Long,
    parserLimits: TerminalParserLimits,
    ambiguousWidth: TerminalAmbiguousWidth
): TerminalState {
    checkSize(columns, rows)
    if (historyLimit < 0L) throw IllegalArgumentException(Some("negative terminal history limit"))
    return TerminalState(columns, rows, historyLimit, parserLimits, ambiguousWidth)
}

private fun checkSize(columns: Long, rows: Long) {
    if (columns <= 0L || rows <= 0L || columns > 65535L || rows > 65535L)
        throw IllegalArgumentException(Some("terminal cell dimensions out of range"))
}
