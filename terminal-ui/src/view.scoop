package scoop.ui.terminal

import scoop.graphics.*
import scoop.graphics.text.FontCollection
import scoop.platform.system.OperatingSystem
import scoop.platform.system.operatingSystem
import scoop.platform.time.MonotonicInstant
import scoop.platform.time.MonotonicTimeSource
import scoop.surface.*
import scoop.terminal.emulator.*
import scoop.time.Duration
import scoop.ui.*
import scoop.window.*
import scoop.window.accessibility.*

private val outputQuietInterval = Duration.milliseconds(24L)

private val outputRefreshInterval = Duration.milliseconds(96L)

/** Embeds one active view of the session, optionally focusing it on its first placement. */
public fun terminalView(
    session: TerminalEmulatorSession,
    appearance: TerminalAppearance = TerminalAppearance(),
    autoFocus: Boolean = false,
    options: TerminalViewOptions = TerminalViewOptions()
): View = element(
    TerminalViewProps(session, appearance, autoFocus, options),
    { props, scope -> TerminalViewElement(props, scope) }
)

private struct TerminalViewProps(
    val session: TerminalEmulatorSession,
    val appearance: TerminalAppearance,
    val autoFocus: Boolean,
    val options: TerminalViewOptions
)

private class TerminalViewElement(
    private val props: Props<TerminalViewProps>,
    scope: ComponentScope
) : Element<TerminalFrame>(scope) {
    private var session = props.value.session
    private var viewport = TerminalViewport { session.reading }
    private var attachment: Disposable? = None
    private var clipboardAdapter: WindowTerminalClipboardAdapter? = None
    private var accepted: GridGeometry? = None
    private var glyphCache: TerminalGlyphCache? = None
    private var observedScreen = session.reading.screenRevision
    private var observedCursor = session.reading.cursor
    private var observedColors = session.reading.colors
    private var themeAppearance = props.value.appearance
    private val screenPaint = PaintKey()
    private var paintRevision = 0L
    private var selecting = false
    private var reported = TerminalMouseButton.NonePressed
    private var lastMouse: TerminalMouse? = None
    private val linkGesture = TerminalLinkGesture()
    private var hovered: TerminalLink? = None
    private var pointerPoint: Point? = None
    private var pointerModifiers: Modifiers? = None
    private var wheelRemainder = 0.0
    private var horizontalWheelRemainder = 0.0
    private val area = scope
        .createArea(focusable = true, textInput = true) { context, event -> route(context, event) }
    private val focus = scope.focusTarget(area)
    private val semantics = scope.semantics(SemanticRole.Text)
    private var lastOutput = MonotonicInstant(0L, 0)
    private var outputRefreshLimit: MonotonicInstant? = None
    private val refreshDeadline = scope.createDeadline { refreshOutput() }
    private var cursorBlinkVisible = true
    private var textBlinkVisible = true
    private val cursorBlinkDeadline = scope.createDeadline { blinkCursor() }
    private val textBlinkDeadline = scope.createDeadline { blinkText() }
    private var visibleTextBlinks = false
    private val composition = TerminalComposition(
        scope.nativeWindow, area,
        { value -> session.send(TerminalInput.Text(value)) },
        { if (scope.isMounted) scope.requestLayout() }
    )

    public override fun onMount() {
        area.scope.defaultAction = area.scope.handler
        area.scope.onEventFinished = { event -> finishedEvent(event) }
        semantics.bindFocus(Some(focus))
        attach()
        resetCursorBlink()
        textBlinkDeadline.schedule(MonotonicTimeSource.now() + Duration.milliseconds(600L))
        if (props.value.autoFocus) focus.handle.requestFocus()
    }

    private fun attach() {
        themeAppearance = props.value.appearance
        session.setColors(themeAppearance.colorTheme())
        observedScreen = session.reading.screenRevision
        observedCursor = session.reading.cursor
        observedColors = session.reading.colors
        clipboardAdapter?.close()
        val clipboard = WindowTerminalClipboardAdapter(scope.nativeWindow)
        clipboardAdapter = Some(clipboard)
        attachment = Some(session.attach(Some(clipboard)) { if (scope.isMounted) modelChanged() })
        refresh()
    }

    public override fun update(): UiInvalidation {
        val appearance = props.value.appearance
        if (appearance.foreground !=
            themeAppearance.foreground ||
            appearance.background !=
            themeAppearance.background ||
            appearance.cursor !=
            themeAppearance.cursor ||
            appearance.palette !==
            themeAppearance.palette
        ) {
            themeAppearance = appearance
            session.setColors(appearance.colorTheme())
        }
        val next = props.value.session
        if (next !== session) {
            cancelInteraction()
            attachment?.dispose()
            accepted = None
            selecting = false
            reported = TerminalMouseButton.NonePressed
            composition.restart()
            session = next
            viewport = TerminalViewport { next.reading }
            attach()
        }
        return UiInvalidation.Layout
    }

    public override fun onUnmount() {
        cancelInteraction()
        refreshDeadline.cancel()
        outputRefreshLimit = None
        cursorBlinkDeadline.cancel()
        textBlinkDeadline.cancel()
        attachment?.dispose()
        attachment = None
        clipboardAdapter?.close()
        clipboardAdapter = None
        accepted = None
        glyphCache?.release()
        glyphCache = None
    }

    private fun modelChanged() {
        val terminal = session.reading
        val colorsChanged = observedColors !== terminal.colors
        observedColors = terminal.colors
        val cursor = terminal.cursor
        val moved = cursor != observedCursor
        if (moved) resetCursorBlink()
        observedCursor = cursor
        val screen = terminal.screenRevision
        if (screen == observedScreen) {
            if (colorsChanged)
                refresh()
            else if (moved && outputRefreshLimit == None && viewport.atBottom) scope.requestFrame()
            return
        }
        observedScreen = screen
        viewport.update()
        val now = MonotonicTimeSource.now()
        lastOutput = now
        if (outputRefreshLimit == None) {
            outputRefreshLimit = Some(now + outputRefreshInterval)
            refreshDeadline.schedule(now + outputQuietInterval)
        }
    }

    private fun resetCursorBlink() {
        cursorBlinkVisible = true
        cursorBlinkDeadline.schedule(MonotonicTimeSource.now() + Duration.milliseconds(500L))
    }

    private fun blinkCursor() {
        if (!scope.isMounted) return
        cursorBlinkVisible = !cursorBlinkVisible
        if (area.isFocusActive && session.reading.cursor.blink) scope.requestFrame()
        cursorBlinkDeadline.schedule(MonotonicTimeSource.now() + Duration.milliseconds(500L))
    }

    private fun blinkText() {
        if (!scope.isMounted) return
        textBlinkVisible = !textBlinkVisible
        if (area.isFocusActive && visibleTextBlinks) scope.requestFrame()
        textBlinkDeadline.schedule(MonotonicTimeSource.now() + Duration.milliseconds(600L))
    }

    private fun refreshOutput() {
        // Coalesce a burst until it quiets down, with a deadline for sustained output.
        val limit = outputRefreshLimit ?: return
        val quiet = lastOutput + outputQuietInterval
        val next = if (quiet < limit) quiet else limit
        if (MonotonicTimeSource.now() < next) {
            refreshDeadline.schedule(next)
        } else {
            outputRefreshLimit = None
            refresh()
        }
    }

    private fun refresh() {
        if (outputRefreshLimit != None) {
            outputRefreshLimit = None
            refreshDeadline.cancel()
        }
        val visible = viewport.visibleText()
        semantics
            .update(
                SemanticProperties(
                    name = Some("Terminal"), value = Some(visible.text),
                    readOnly = true, selection = visible.selection
                )
            )
        area.setCaret(None, Some(composition.revision))
        scope.requestLayout()
    }

    private fun glyphs(fonts: FontCollection, appearance: TerminalAppearance): TerminalGlyphCache {
        val previous = glyphCache
        when (previous) {
            case Some(val value) -> if (value.canReuse(fonts, appearance)) return value
            case None -> {}
        }
        val next = TerminalGlyphCache(fonts, appearance)
        glyphCache = Some(next)
        previous?.release()
        return next
    }

    public override fun measure(context: MeasureContext, constraints: Constraints): LayoutResult<
        TerminalFrame
    > {
        val appearance = props.value.appearance
        val glyphs = glyphs(scope.defaultFonts, appearance)
        val terminal = session.reading
        val metrics = glyphs.metrics
        val size = constraints
            .constrain(
                Size(
                    constraints.maxWidth ?: terminal.columns.toDouble() * metrics.width,
                    constraints.maxHeight ?: terminal.rows.toDouble() * metrics.height
                )
            )
        val columns = clamp((size.width / metrics.width).toLong(), 0L, 32767L)
        val rows = clamp((size.height / metrics.height).toLong(), 0L, 32767L)
        val first = viewport.first
        val visible = terminal.lines(first, clamp(rows, 0L, terminal.rows))
        val geometry = GridGeometry(
            size, metrics, first, visible, columns, rows, terminal.screenRevision,
            first == terminal.historySize, terminal, scope.nativeWindow.metrics?.scaleFactor ?: 1.0
        )
        paintRevision += 1L
        val frame = TerminalFrame(
            geometry, paintRevision, terminal.cursor, composition.revision, appearance, glyphs
        )
        try {
            frame.shape(viewport.range(), composition.text)
            return LayoutResult(LayoutMetrics(size), frame, { frame.close() })
        } catch (error: Throwable) {
            frame.close()
            throw error
        }
    }

    public override fun scene(context: SceneContext, measured: TerminalFrame) {
        val bounds = Rect(0.0, 0.0, context.size.width, context.size.height)
        val owner = session
        val geometry = measured.geometry
        val terminal = owner.reading
        // The live cursor belongs to this grid only until pending screen output changes it.
        val cursor = if (geometry.screenRevision == terminal.screenRevision)
            terminal.cursor
        else
            measured.cursor
        val caret = geometry.caret(cursor)
        area.setCaret(caret, Some(measured.inputRevision))
        context.place(area, bounds)
        context.semantics(semantics, bounds)
        visibleTextBlinks = measured.hasBlink
        val textVisible = !area.isFocusActive || textBlinkVisible || !measured.hasBlink
        context
            .drawLayer(
                screenPaint,
                bounds,
                measured.paintRevision * 2L + if (textVisible) 1L else 0L
            ) { paint -> measured.drawScreen(paint.canvas, textVisible) }
        val link = hovered
        context.draw { paint -> measured.drawLinks(paint.canvas, link) }
        when (caret) {
            case Some(val rect) -> {
                val focused = area.isFocusActive
                val blinkVisible = cursorBlinkVisible
                val glyph = if (focused) measured.cursorGlyph(cursor) else None
                context
                    .draw { paint ->
                        measured
                            .drawCursor(paint.canvas, rect, cursor, focused, blinkVisible, glyph)
                    }
            }

            case None -> {}
        }
        context
            .onFrameComplete { completion ->
                if (scope.isMounted &&
                    session ===
                    owner &&
                    completion.submission ==
                    FrameSubmission.Accepted
                ) {
                    accepted = Some(geometry)
                    updateHover(geometry)
                    if (geometry.columns > 0L && geometry.requestedRows > 0L)
                        owner
                            .requestSize(
                                geometry.columns,
                                geometry.requestedRows,
                                Some(
                                    TerminalPixelSize(
                                        clamp(
                                            (
                                                geometry.columns.toDouble() *
                                                    geometry.metrics.width *
                                                    geometry.scaleFactor +
                                                    0.5
                                            )
                                                .toLong(),
                                            1L,
                                            2147483647L
                                        ),
                                        clamp(
                                            (
                                                geometry.requestedRows.toDouble() *
                                                    geometry.metrics.height *
                                                    geometry.scaleFactor +
                                                    0.5
                                            )
                                                .toLong(),
                                            1L,
                                            2147483647L
                                        ),
                                        clamp(
                                            (geometry.metrics.width * geometry.scaleFactor + 0.5)
                                                .toLong(),
                                            1L,
                                            2147483647L
                                        ),
                                        clamp(
                                            (geometry.metrics.height * geometry.scaleFactor + 0.5)
                                                .toLong(),
                                            1L,
                                            2147483647L
                                        )
                                    )
                                )
                            )
                }
            }
    }

    private fun route(context: RoutedEventContext, event: InputEvent) {
        if (context.phase == RoutedPhase.Notification) {
            when (event) {
                case TextInput(val text) -> composition.input(text)

                case FocusChanged(val active) -> {
                    if (!active) cancelInteraction()
                    session.send(TerminalInput.Focus(active))
                    // The surface also delivers focus loss during retirement.
                    if (scope.isMounted) {
                        resetCursorBlink()
                        scope.requestFrame()
                    }
                }

                case Pointer(val pointer) ->
                    when (pointer) {
                        case Cancelled(_, _) -> cancelInteraction()

                        case Left(_) -> {
                            pointerPoint = None;
                            setHovered(None)
                        }

                        case _ -> {}
                    }

                else -> {}
            }
        } else if (context.phase == RoutedPhase.Default) {
            val handled = when (event) {
                case Keyboard(val key) -> keyboard(key)
                case Pointer(val pointer) -> pointerEvent(context, pointer)
                case TextCommand(val command) -> clipboardCommand(command)
                else -> false
            }
            if (handled) context.consume()
        }
    }

    private fun keyboard(event: KeyEvent): Boolean {
        if (event.state != ElementState.Pressed) return false
        val modifiers = event.modifiers
        val shortcut = if (operatingSystem == OperatingSystem.Darwin)
            modifiers.superKey
        else
            modifiers.shift && modifiers.control
        if (shortcut) {
            when (event.logicalKey) {
                case Character(val value) -> {
                    if (value == "c" || value == "C") return clipboardCommand(TextEditCommand.Copy)
                    if (value == "v" || value == "V") return clipboardCommand(TextEditCommand.Paste)
                }

                case _ -> {}
            }
        }
        val key = terminalKey(event) ?: return false
        session.send(TerminalInput.Key(key, modifiers.terminalModifiers()))
        return true
    }

    private fun clipboardCommand(command: TextEditCommand): Boolean = when (command) {
        case Copy -> {
            val text = viewport.copy()
            if (text != None) scope.nativeWindow.clipboard.writeText(text!!)
            true
        }

        case Paste -> {
            val text = scope.nativeWindow.clipboard.readText()
            if (text != None) session.send(TerminalInput.Paste(text!!))
            true
        }

        case _ -> false
    }

    private fun pointerEvent(context: RoutedEventContext, event: InputPointerEvent): Boolean {
        val frame = accepted ?: return false
        val point = context.localPosition ?: return false
        pointerPoint = Some(point)
        val modifiers = when (event) {
            case Button(val pointer, _, _, _) -> pointer.state.modifiers
            case Moved(val pointer) -> pointer.state.modifiers
            case Wheel(val pointer, _, _, _) -> pointer.state.modifiers
            case _ -> return false
        }
        pointerModifiers = Some(modifiers)
        updateHover(frame)
        val pixels = TerminalPixelPosition(
            (point.x * frame.scaleFactor).toLong(), (point.y * frame.scaleFactor).toLong()
        )
        val hit = frame.hit(point)
        val(row, column) = when (hit) {
            case Some(val value) -> value

            case None -> {
                if (!selecting && !linkGesture.active && reported == TerminalMouseButton.NonePressed
                )
                    return false
                frame.clampedHit(point) ?: return false
            }
        }
        return when (event) {
            case Button(val pointer, val button, val state, _) ->
                button(frame, row, column, pixels, pointer.state.modifiers, button, state)
            case Moved(val pointer) -> motion(frame, row, column, pixels, pointer.state.modifiers)
            case Wheel(val pointer, val delta, _, _) ->
                wheel(frame, row, column, pixels, pointer.state.modifiers, delta)
            case _ -> false
        }
    }

    private fun button(
        frame: GridGeometry,
        row: Long,
        column: Long,
        pixels: TerminalPixelPosition,
        modifiers: Modifiers,
        mouse: MouseButton,
        state: ElementState
    ): Boolean {
        val mapped = when (mouse) {
            case Left -> TerminalMouseButton.Left
            case Middle -> TerminalMouseButton.Middle
            case Right -> TerminalMouseButton.Right
            case Other(_) -> return false
        }
        if (state == ElementState.Pressed) {
            area.requestFocus(FocusOrigin.Pointer)
            if (reportMouse(frame, modifiers)) {
                if (!area.scope.claimPointer(mouse)) return false
                reported = mapped
                sendMouse(TerminalMouseAction.Press, mapped, row, column, pixels, modifiers)
                return true
            }
            if (mapped == TerminalMouseButton.Left) {
                if (!area.scope.claimPointer(mouse)) return false
                val location = location(frame, row, column)
                val activate = if (operatingSystem == OperatingSystem.Darwin)
                    modifiers.superKey
                else
                    modifiers.control
                when (val link = frame.reading.linkAt(frame.first + row, column)) {
                    case Some(val value) ->
                        if (activate) {
                            linkGesture.begin(value, location, pixels, frame.scaleFactor)
                            return true
                        }
                    case None -> {}
                }
                if (modifiers.shift && viewport.range() != None)
                    viewport.extend(location)
                else
                    viewport.select(location)
                selecting = true
                refresh()
                return true
            }
        } else {
            if (mapped == TerminalMouseButton.Left && linkGesture.active) {
                val link = linkGesture
                    .release(
                        when (val point = pointerPoint) {
                            case Some(val value) -> frame.linkAt(value)
                            case None -> None
                        },
                        pixels
                    )
                when (link) {
                    case Some(val value) -> props.value.options.onLinkActivated(value)
                    case None -> {}
                }
                return true
            }
            if (reported == mapped) {
                reported = TerminalMouseButton.NonePressed
                sendMouse(TerminalMouseAction.Release, mapped, row, column, pixels, modifiers)
                return true
            }
            if (mapped == TerminalMouseButton.Left && selecting) {
                selecting = false
                viewport.extend(location(frame, row, column))
                refresh()
                return true
            }
        }
        return false
    }

    private fun motion(
        frame: GridGeometry,
        row: Long,
        column: Long,
        pixels: TerminalPixelPosition,
        modifiers: Modifiers
    ): Boolean {
        when (val origin = linkGesture.drag(pixels)) {
            case Some(val value) -> {
                viewport.select(value);
                selecting = true
            }

            case None -> {}
        }
        if (linkGesture.active) return true
        if (selecting) {
            viewport.extend(location(frame, row, column))
            refresh()
            return true
        }
        if (reportMouse(frame, modifiers)) {
            sendMouse(TerminalMouseAction.Move, reported, row, column, pixels, modifiers)
            return true
        }
        return false
    }

    private fun wheel(
        frame: GridGeometry,
        row: Long,
        column: Long,
        pixels: TerminalPixelPosition,
        modifiers: Modifiers,
        delta: InputScrollDelta
    ): Boolean {
        val(horizontal, lines) = when (delta) {
            case Lines(val x, val y) -> (x, y)
            case Pixels(val x, val y) -> (x / frame.metrics.width, y / frame.metrics.height)
        }
        wheelRemainder += lines
        val steps = clamp(wheelRemainder.toLong(), -128L, 128L)
        wheelRemainder -= steps.toDouble()
        horizontalWheelRemainder += horizontal
        val horizontalSteps = clamp(horizontalWheelRemainder.toLong(), -128L, 128L)
        horizontalWheelRemainder -= horizontalSteps.toDouble()
        if (steps == 0L && horizontalSteps == 0L) return lines != 0.0 || horizontal != 0.0
        if (reportMouse(frame, modifiers)) {
            val mouse = if (steps > 0L)
                TerminalMouseButton.WheelUp
            else
                TerminalMouseButton.WheelDown
            val count = if (steps > 0L) steps else -steps
            for (index in 0L..<count)
                sendMouse(TerminalMouseAction.Press, mouse, row, column, pixels, modifiers)
            val horizontalMouse = if (horizontalSteps > 0L)
                TerminalMouseButton.WheelLeft
            else
                TerminalMouseButton.WheelRight
            val horizontalCount = if (horizontalSteps > 0L) horizontalSteps else -horizontalSteps
            for (index in 0L..<horizontalCount)
                sendMouse(
                    TerminalMouseAction.Press,
                    horizontalMouse,
                    row,
                    column,
                    pixels,
                    modifiers
                )
            return true
        }
        if (viewport.scroll(-steps)) {
            refresh()
            return true
        }
        return false
    }

    private fun reportMouse(frame: GridGeometry, modifiers: Modifiers): Boolean {
        val terminal = session.reading
        return !modifiers.shift &&
            frame.atBottom &&
            viewport.atBottom &&
            session.mouseReporting &&
            frame.columns ==
            terminal.columns &&
            frame.requestedRows ==
            terminal.rows &&
            frame.scaleFactor ==
            (scope.nativeWindow.metrics?.scaleFactor ?: 1.0)
    }

    private fun sendMouse(
        action: TerminalMouseAction,
        button: TerminalMouseButton,
        row: Long,
        column: Long,
        pixels: TerminalPixelPosition,
        modifiers: Modifiers
    ) {
        val value = TerminalMouse(
            action,
            button,
            row,
            column,
            modifiers.terminalModifiers(),
            Some(pixels)
        )
        lastMouse = Some(value)
        session.send(TerminalInput.Mouse(value))
    }

    private fun setHovered(value: TerminalLink?) {
        if (hovered?.key == value?.key) return
        hovered = value
        props.value.options.onLinkHovered(value)
        if (scope.isMounted) scope.requestFrame()
    }

    private fun updateHover(frame: GridGeometry) {
        val point = pointerPoint
        val captured = when (val modifiers = pointerModifiers) {
            case Some(val value) -> reportMouse(frame, value)
            case None -> false
        }
        setHovered(
            if (captured)
                None
            else
                when (point) {
                    case Some(val value) -> frame.linkAt(value)
                    case None -> None
                }
        )
    }

    private fun cancelInteraction() {
        selecting = false
        linkGesture.cancel()
        val button = reported
        reported = TerminalMouseButton.NonePressed
        when (val last = lastMouse) {
            case Some(val value) ->
                if (button != TerminalMouseButton.NonePressed)
                    session
                        .send(
                            TerminalInput
                                .Mouse(value.{action: TerminalMouseAction.Release, button: button})
                        )
            case None -> {}
        }
        lastMouse = None
        pointerPoint = None
        setHovered(None)
        area.scope.cancelPointerClaim()
    }

    private fun finishedEvent(event: InputEvent) {
        when (event) {
            case Pointer(val pointer) ->
                when (pointer) {
                    case Button(_, val button, val state, _) ->
                        if (state ==
                            ElementState.Released &&
                            (
                                (button == MouseButton.Left && (selecting || linkGesture.active)) ||
                                    (
                                        reported ==
                                            TerminalMouseButton.Left &&
                                            button ==
                                            MouseButton.Left
                                    ) ||
                                    (
                                        reported ==
                                            TerminalMouseButton.Middle &&
                                            button ==
                                            MouseButton.Middle
                                    ) ||
                                    (
                                        reported ==
                                            TerminalMouseButton.Right &&
                                            button ==
                                            MouseButton.Right
                                    )
                            )
                        )
                            cancelInteraction()
                    case _ -> {}
                }
            case _ -> {}
        }
    }
}

private fun location(frame: GridGeometry, row: Long, column: Long): CellLocation {
    val line = frame.rows[row]
    val index = clamp(column, 0L, line.cells.size - 1L)
    val start = if (line.cells[index].width == 0L) index - 1L else index
    return CellLocation(line.id, start, frame.reading.anchorAt(frame.first + row, start))
}
