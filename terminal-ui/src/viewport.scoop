package scoop.ui.terminal

import scoop.collections.withIndex
import scoop.terminal.emulator.*
import scoop.window.Utf8Selection

internal struct CellLocation(val id: Long, val column: Long, val anchor: TerminalAnchor? = None)

internal struct CellSpan(val start: Long, val end: Long)

/** Physical, half-open coordinates for one accepted reading. */
internal struct SelectionRange(
    val startRow: Long,
    val startColumn: Long,
    val endRow: Long,
    val endColumn: Long,
    val reversed: Boolean
) {
    fun onRow(row: Long, line: TerminalLine): CellSpan? {
        if (row < startRow || row > endRow) return None
        val columns = line.cells.size
        val left = if (row == startRow) clamp(startColumn, 0L, columns) else 0L
        val right = if (row == endRow) clamp(endColumn, left, columns) else columns
        if (right <= left) return None
        return Some(
            CellSpan(
                if (left < columns && line.cells[left].width == 0L) left - 1L else left,
                if (right < columns && line.cells[right].width == 0L) right + 1L else right
            )
        )
    }
}

internal struct VisibleText(val text: String, val selection: Utf8Selection?)

internal struct ViewportUpdate(
    val invalidated: TerminalInvalidation?,
    val resetInteraction: Boolean
)

private class BufferViewport {
    var epoch = -1L
    var top: TerminalTrackedRange? = None
    var topFallback: TerminalAnchor? = None
    var topPresentation = -1L
    var ranges: Array<TerminalTrackedRange> = []
    var origin: TerminalTrackedRange? = None
    var mode = TerminalSelectionMode.Linear
    var unit = TerminalSelectionUnit.Grapheme
    var reversed = false
    var rectangleColumn = 0L
    fun clearSelection() {
        for (range in ranges)
            range.close()
        ranges = [];
        origin?.close();
        origin = None
    }
    fun close() {
        top?.close();
        top = None;
        clearSelection()
    }
}

internal class TerminalViewport(
    private val current: () -> TerminalReading,
    private val track: (
        TerminalRange,
        TerminalTrackingKind,
        TerminalReading
    ) -> TerminalTrackedRange
) : Closeable {
    val terminal: TerminalReading get() = current()
    fun trackRange(range: TerminalRange, reading: TerminalReading): TerminalTrackedRange = track(
        range,
        TerminalTrackingKind.Content,
        reading
    )
    private val main = BufferViewport()
    private val alternate = BufferViewport()
    private val words = TerminalWordSelection()
    private var epoch = terminal.bufferEpoch
    private var columns = terminal.columns
    private var rows = terminal.rows
    private var activeDrag = false
    val dragging: Boolean get() = activeDrag

    private fun buffer(): BufferViewport {
        val reading = terminal
        val state = if (reading.alternateScreen) alternate else main
        if (state.epoch != reading.bufferEpoch) {
            state.close();
            state.epoch = reading.bufferEpoch
        }
        return state
    }

    val first: Long
        get() {
            val reading = terminal
            val top = buffer().top ?: return reading.historySize
            return when (top.state(reading)) {
                case Available(val range) ->
                    clamp(reading.resolve(range.start)?.row ?: 0L, 0L, reading.historySize)

                case Invalidated(_) -> {
                    val state = buffer()
                    val fallback = state.topFallback
                    if (state.topPresentation == reading.presentationVersion && fallback != None)
                        clamp(reading.resolve(fallback!!)?.row ?: 0L, 0L, reading.historySize)
                    else
                        0L
                }
            }
        }
    val atBottom: Boolean get() = first == terminal.historySize

    fun update(): ViewportUpdate {
        val reading = terminal
        val reset = epoch !=
            reading.bufferEpoch ||
            columns !=
            reading.columns ||
            rows !=
            reading.rows
        epoch = reading.bufferEpoch;
        columns = reading.columns;
        rows = reading.rows
        if (reset) endDrag()
        val previous = if (reading.alternateScreen) alternate else main
        val retired = previous.epoch != reading.bufferEpoch && previous.ranges.size > 0L
        val state = buffer()
        when (val top = state.top) {
            case Some(val handle) ->
                when (handle.state(reading)) {
                    case Invalidated(_) -> {
                        if (state.topPresentation !=
                            reading.presentationVersion ||
                            state.topFallback ==
                            None
                        ) {
                            handle.close();
                            state.top = None
                            if (reading.historySize > 0L) setTop(0L)
                        }
                    }

                    case Available(_) -> {}
                }
            case None -> {}
        }
        var reason: TerminalInvalidation? = if (retired) Some(TerminalInvalidation.Stale) else None
        var changed = false
        val retained = ArrayList<TerminalTrackedRange>()
        for (handle in state.ranges) {
            when (handle.state(reading)) {
                case Available(_) -> retained.add(handle)

                case Invalidated(val cause) -> {
                    if (cause != TerminalInvalidation.Evicted || reason == None)
                        reason = Some(cause)
                    handle.close();
                    changed = true
                }
            }
        }
        if (changed) {
            state.ranges = retained.toArray()
            if (reason != Some(TerminalInvalidation.Evicted) || state.ranges.size == 0L)
                state.clearSelection()
            endDrag()
        }
        when (val origin = state.origin) {
            case Some(val handle) ->
                when (handle.state(reading)) {
                    case Invalidated(_) -> {
                        handle.close();
                        state.origin = None
                        when (val remaining = selection) {
                            case Some(val selected) -> {
                                val point = if (state.reversed)
                                    selected.ranges[selected.ranges.size - 1L].end
                                else
                                    selected.ranges[0L].start
                                state.origin = Some(
                                    track(
                                        TerminalRange(point, point),
                                        TerminalTrackingKind.Position,
                                        reading
                                    )
                                )
                                state.rectangleColumn = reading.resolve(point)?.column ?: 0L
                            }

                            case None -> {}
                        }
                    }

                    case Available(_) -> {}
                }
            case None -> {}
        }
        return ViewportUpdate(reason, reset || changed)
    }

    fun scroll(lines: Long): Boolean {
        update()
        val old = first
        val destination = if (lines > terminal.historySize - old)
            terminal.historySize
        else if (lines < -old) 0L else old + lines
        if (old == destination) return false
        setTop(destination)
        return true
    }

    fun setTop(row: Long) {
        val state = buffer()
        val reading = terminal
        val destination = clamp(row, 0L, reading.historySize)
        state.topFallback = if (destination == reading.historySize)
            None
        else
            reading.anchorAt(destination, 0L)
        state.topPresentation = reading.presentationVersion
        val next = if (destination == reading.historySize)
            None
        else {
            val anchor = reading.anchorAt(destination, 0L)!!
            Some(track(TerminalRange(anchor, anchor), TerminalTrackingKind.Position, reading))
        }
        state.top?.close();
        state.top = next
    }

    val selection: TerminalSelection?
        get() {
            buffer()
            return selectionIn(terminal)
        }

    /** Resolve the handles in the displayed generation, never in an unrelated live grid. */
    fun selectionIn(reading: TerminalReading): TerminalSelection? {
        val state = if (reading.alternateScreen) alternate else main
        if (state.epoch != reading.bufferEpoch || state.ranges.size == 0L) return None
        val ranges = ArrayList<TerminalRange>()
        for (handle in state.ranges)
            when (handle.state(reading)) {
                case Available(val range) -> ranges.add(range)
                case Invalidated(_) -> return None
            }
        return Some(TerminalSelection(ranges.toArray(), state.mode, state.unit, state.reversed))
    }

    fun select(
        location: CellLocation,
        unit: TerminalSelectionUnit = TerminalSelectionUnit.Grapheme,
        mode: TerminalSelectionMode = TerminalSelectionMode.Linear,
        additionalWordCharacters: String = "",
        source: TerminalReading? = None
    ): Boolean {
        update()
        val reading = source ?: terminal
        val point = locationAnchor(location, reading) ?: return false
        val range = unitRange(reading, point, unit, additionalWordCharacters) ?: return false
        if (!replace([range], mode, unit, false, reading)) return false
        val state = buffer()
        state.origin?.close()
        state.origin = Some(track(range, TerminalTrackingKind.Position, reading))
        state.rectangleColumn = location.column
        activeDrag = true
        return true
    }

    fun extend(
        location: CellLocation,
        additionalWordCharacters: String = "",
        source: TerminalReading? = None
    ): Boolean {
        update()
        val state = buffer()
        val origin = state.origin ?: return false
        val original = when (origin.state(terminal)) {
            case Available(val range) -> range
            case Invalidated(_) -> return false
        }
        val reading = source ?: terminal
        val point = locationAnchor(location, reading) ?: return false
        val destination = unitRange(reading, point, state.unit, additionalWordCharacters) ?:
            return false
        val start = terminal.resolve(original.start) ?: return false
        val end = terminal.resolve(original.end) ?: return false
        val targetStart = terminal.resolve(destination.start) ?: return false
        val targetEnd = terminal.resolve(destination.end) ?: return false
        val reverse = before(targetStart, start)
        val ranges = if (state.mode == TerminalSelectionMode.Rectangular) {
            val top = if (targetStart.row < start.row) targetStart.row else start.row
            val bottom = if (targetStart.row > start.row) targetStart.row else start.row
            val left = if (location.column < state.rectangleColumn)
                location.column
            else
                state.rectangleColumn
            val right = if (location.column > state.rectangleColumn)
                location.column + 1L
            else
                state.rectangleColumn + 1L
            Array<TerminalRange>(bottom - top + 1L) { offset ->
                selectionRange(
                    terminal,
                    TerminalPosition(top + offset, clamp(left, 0L, terminal.columns)),
                    TerminalPosition(top + offset, clamp(right, 0L, terminal.columns))
                )!!
            }
        } else
            [
                TerminalRange(
                    if (reverse) destination.start else original.start,
                    if (before(end, targetEnd)) destination.end else original.end
                )
            ]
        if (!replace(ranges, state.mode, state.unit, reverse, reading)) return false
        activeDrag = true
        return true
    }

    fun selectRange(range: TerminalRange): Boolean {
        update()
        val reading = terminal
        val start = reading.resolve(range.start) ?: return false
        val end = reading.resolve(range.end) ?: return false
        if (before(end, start)) return false
        val expanded = selectionRange(reading, start, end) ?: return false
        if (!replace(
            [expanded],
            TerminalSelectionMode.Linear,
            TerminalSelectionUnit.Grapheme,
            false,
            reading
        )
        )
            return false
        val state = buffer()
        state.origin?.close()
        state.origin = Some(
            track(
                TerminalRange(expanded.start, expanded.start),
                TerminalTrackingKind.Position,
                reading
            )
        )
        endDrag()
        return true
    }

    fun selectAll(): Boolean {
        val reading = terminal
        return selectRange(
            TerminalRange(
                reading.anchorAt(0L, 0L)!!,
                reading
                    .anchorAt(
                        reading.historySize + reading.rows - 1L,
                        reading.columns,
                        TerminalAffinity.Before
                    )!!
            )
        )
    }

    fun clearSelection() {
        buffer().clearSelection();
        endDrag()
    }
    fun endDrag() {
        activeDrag = false;
        words.clear()
    }

    private fun replace(
        ranges: Array<TerminalRange>,
        mode: TerminalSelectionMode,
        unit: TerminalSelectionUnit,
        reversed: Boolean,
        source: TerminalReading
    ): Boolean {
        val next = ArrayList<TerminalTrackedRange>()
        var accepted = false
        try {
            for (range in ranges) {
                val handle = track(range, TerminalTrackingKind.Content, source)
                next.add(handle)
                when (handle.state(terminal)) {
                    case Invalidated(_) -> return false
                    case Available(_) -> {}
                }
            }
            val state = buffer()
            for (handle in state.ranges)
                handle.close()
            state.ranges = next.toArray();
            state.mode = mode;
            state.unit = unit;
            state.reversed = reversed
            accepted = true
            return true
        } finally {
            if (!accepted)
                for (handle in next)
                    handle.close()
        }
    }

    private fun unitRange(
        reading: TerminalReading,
        point: TerminalAnchor,
        unit: TerminalSelectionUnit,
        extra: String
    ): TerminalRange? {
        return when (unit) {
            case Grapheme -> {
                val position = reading.resolve(point) ?: return None
                graphemeRange(reading, position)
            }

            case Word -> words.range(reading, point, extra)
            case LogicalLine -> reading.logicalLineRange(point.logicalLineId)
        }
    }

    private fun locationAnchor(location: CellLocation, reading: TerminalReading): TerminalAnchor? {
        when (location.anchor) {
            case Some(val value) -> return if (reading.resolve(value) != None) Some(value) else None
            case None -> {}
        }
        val index = reading.findLine(location.id) ?: return None
        val line = reading.lines(index, 1L)[0L]
        val column = clamp(location.column, 0L, line.cells.size - 1L)
        val start = if (line.cells[column].width == 0L) column - 1L else column
        return reading.anchorAt(index, start)
    }

    fun ranges(): Array<SelectionRange> {
        return terminalSelectionRanges(terminal, selection)
    }

    fun copy(options: TerminalCopyOptions = TerminalCopyOptions()): String? {
        val selected = selection ?: return None
        val result = StringBuilder()
        for ((index, range) in selected.ranges.withIndex()) {
            if (index > 0L && selected.mode == TerminalSelectionMode.Rectangular)
                result.append('\n')
            result.append(terminal.text(range, options.trimPadding) ?: return None)
        }
        return Some(result.toString())
    }

    fun visibleText(): VisibleText {
        val selected = selection
        return TerminalTextProjection(first, terminal.lines(first, terminal.rows))
            .read(selected, terminalSelectionRanges(terminal, selected))
    }

    public override fun close() {
        main.close();
        alternate.close();
        endDrag()
    }
}

internal fun sameSelection(left: TerminalSelection?, right: TerminalSelection?): Boolean {
    return when (left) {
        case None -> right?.mode == None
        case Some(val a) ->
            when (right) {
                case None -> false

                case Some(val b) -> {
                    if (a.mode !=
                        b.mode ||
                        a.unit !=
                        b.unit ||
                        a.reversed !=
                        b.reversed ||
                        a.ranges.size !=
                        b.ranges.size
                    )
                        return false
                    for (index in 0L..<a.ranges.size)
                        if (a.ranges[index] != b.ranges[index]) return false
                    true
                }
            }
    }
}

internal fun clamp(value: Long, minimum: Long, maximum: Long): Long = if (value < minimum)
    minimum
else if (value > maximum) maximum else value
