package scoop.ui.terminal

import scoop.graphics.Color
import scoop.terminal.emulator.*

public struct TerminalAppearance(
    val families: Array<String> = ["Menlo", "Consolas", "DejaVu Sans Mono", "monospace"],
    val fontSize: Double = 14.0,
    val foreground: Color = Color(0.88, 0.90, 0.92),
    val background: Color = Color(0.08, 0.09, 0.11),
    val selection: Color = Color(0.23, 0.43, 0.68, 0.65),
    val searchHighlight: Color = Color(0.9, 0.65, 0.05, 0.3),
    val activeSearchHighlight: Color = Color(1.0, 0.75, 0.1, 0.5),
    val cursor: Color = Color(0.84, 0.88, 0.93),
    val palette: Array<TerminalRgb> = defaultTerminalPalette()
)

internal fun TerminalAppearance.colorTheme(): TerminalColors = TerminalColors(
    palette, terminalRgb(foreground), terminalRgb(background), terminalRgb(cursor)
)

internal fun TerminalRgb.color(): Color = Color(
    red.toDouble() / 65535.0, green.toDouble() / 65535.0, blue.toDouble() / 65535.0
)

private fun terminalRgb(value: Color): TerminalRgb = TerminalRgb(
    clamp((value.red * 65535.0 + 0.5).toLong(), 0L, 65535L).toInt(),
    clamp((value.green * 65535.0 + 0.5).toLong(), 0L, 65535L).toInt(),
    clamp((value.blue * 65535.0 + 0.5).toLong(), 0L, 65535L).toInt()
)

internal fun resolveColor(
    value: TerminalColor,
    defaultColor: Color,
    colors: TerminalColors
): Color = when (value) {
    case Default -> defaultColor
    case Indexed(val index) -> colors.palette[clamp(index.toLong(), 0L, 255L)].color()
    case Rgb(val red, val green, val blue) ->
        Color(red.toDouble() / 255.0, green.toDouble() / 255.0, blue.toDouble() / 255.0)
}
