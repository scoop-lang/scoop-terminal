package scoop.ui.terminal

import scoop.graphics.*
import scoop.graphics.text.*
import scoop.terminal.emulator.*

internal struct GridGeometry(
    val size: Size,
    val metrics: CellMetrics,
    val first: Long,
    val rows: Array<TerminalLine>,
    val columns: Long,
    val requestedRows: Long,
    val screenRevision: Long,
    val atBottom: Boolean,
    val reading: TerminalReading,
    val scaleFactor: Double = 1.0
) {
    fun hit(point: Point): (Long, Long)? {
        if (point.x < 0.0 || point.y < 0.0 || point.x >= size.width || point.y >= size.height)
            return None
        val row = (point.y / metrics.height).toLong()
        val column = (point.x / metrics.width).toLong()
        if (row >= rows.size || column >= columns) return None
        return Some((row, column))
    }

    fun linkAt(point: Point): TerminalLink? {
        val(row, column) = hit(point) ?: return None
        return reading.linkAt(first + row, column)
    }

    fun clampedHit(point: Point): (Long, Long)? {
        if (rows.size == 0L || columns == 0L) return None
        val row = clamp((point.y / metrics.height).toLong(), 0L, rows.size - 1L)
        val last = clamp(columns, 0L, rows[row].cells.size) - 1L
        if (last < 0L) return None
        return Some((row, clamp((point.x / metrics.width).toLong(), 0L, last)))
    }

    fun caret(cursor: TerminalCursor): Rect? = if (atBottom &&
        cursor.row <
        rows.size &&
        cursor.column <
        columns
    )
        Some(
            rect(
                cursor.row, cursor.column,
                if (rows[cursor.row].cells[cursor.column].width > 0L)
                    rows[cursor.row].cells[cursor.column].width
                else
                    1L
            )
        )
    else
        None

    fun rect(row: Long, column: Long, width: Long = 1L): Rect = Rect(
        column.toDouble() * metrics.width, row.toDouble() * metrics.height,
        width.toDouble() * metrics.width, metrics.height
    )
}

private struct PaintCell(
    val bounds: Rect,
    val layout: TextLayout?,
    val foreground: Color,
    val background: Color,
    val underline: TerminalUnderline,
    val underlineColor: Color,
    val struck: Boolean,
    val blink: Boolean
)

private struct PaintLink(val bounds: Rect, val link: TerminalLink, val color: Color)

internal class TerminalFrame(
    val geometry: GridGeometry,
    val paintRevision: Long,
    val cursor: TerminalCursor,
    val inputRevision: Long,
    private val appearance: TerminalAppearance,
    private val glyphs: TerminalGlyphCache,
    private val commandSeparators: Boolean = false
) : Closeable {
    private val colors = geometry.reading.colors
    private val foreground = colors.foreground.color()
    private val background = colors.background.color()
    private val cursorColor = colors.cursor.color()
    private val cells = ArrayList<PaintCell>()
    private val selection = ArrayList<Rect>()
    private val links = ArrayList<PaintLink>()
    private val separators = ArrayList<Double>()
    private var preedit: TextLayout? = None
    private var blinkingText = false
    val hasBlink: Boolean get() = blinkingText

    init {
        glyphs.retain()
    }

    fun shape(ranges: Array<SelectionRange>, composition: String) {
        var index = 0L
        for (line in geometry.rows) {
            val last = clamp(line.cells.size, 0L, geometry.columns)
            var column = 0L
            while (column < last) {
                val cell = line.cells[column]
                if (cell.width != 0L && column + cell.width <= last) addCell(index, column, cell)
                column += 1L
            }
            for (range in ranges) {
                when (val selected = range.onRow(geometry.first + index, line)) {
                    case Some(val span) -> {
                        val end = clamp(span.end, 0L, geometry.columns)
                        if (end > span.start)
                            selection.add(geometry.rect(index, span.start, end - span.start))
                    }

                    case None -> {}
                }
            }
            index += 1L
        }
        if (composition != "") preedit = Some(glyphs.shapePreedit(composition, foreground))
        if (commandSeparators && !geometry.reading.alternateScreen) {
            val occupied = MutableArray<Boolean>(geometry.rows.size) { false }
            for (index in 0L..<geometry.reading.commandCount) {
                val block = geometry.reading.commands(index, 1L)[0L]
                if (!block.separator) continue
                val anchor = block.prompt ?: continue
                val position = geometry.reading.resolve(anchor) ?: continue
                val row = position.row - geometry.first
                if (row >= 0L && row < occupied.size) occupied[row] = true
            }
            for (row in 0L..<occupied.size)
                if (occupied[row]) separators.add(row.toDouble() * geometry.metrics.height)
        }
    }

    private fun addCell(row: Long, column: Long, cell: TerminalCell) {
        val foregroundInk = resolveColor(cell.style.foreground, foreground, colors)
        val backgroundInk = resolveColor(cell.style.background, background, colors)
        val fullInk = if (cell.style.inverse) backgroundInk else foregroundInk
        val paper = if (cell.style.inverse) foregroundInk else backgroundInk
        val ink = if (cell.style.faint)
            Color(
                (fullInk.red + paper.red) / 2.0, (fullInk.green + paper.green) / 2.0,
                (fullInk.blue + paper.blue) / 2.0, fullInk.alpha
            )
        else
            fullInk
        val visible = cell.text != "" && !cell.style.concealed
        if (cell.style.blink && !cell.style.concealed) blinkingText = true
        val glyph = if (visible) Some(glyphs.layout(cell, ink)) else None
        if (!cell.style.concealed) {
            when (val link = geometry.reading.link(cell.linkId)) {
                case Some(val value) ->
                    links.add(PaintLink(geometry.rect(row, column, cell.width), value, ink))
                case None -> {}
            }
        }
        if (visible || paper != background || cell.style.underlined || cell.style.struck)
            cells
                .add(
                    PaintCell(
                        geometry.rect(row, column, cell.width), glyph, ink, paper,
                        if (cell.style.concealed)
                            TerminalUnderline.None
                        else
                            cell.style.underlineStyle,
                        resolveColor(cell.style.underlineColor, ink, colors), cell.style.struck &&
                            !cell.style.concealed,
                        cell.style.blink
                    )
                )
    }

    private val clip: Rect get() = Rect(0.0, 0.0, geometry.size.width, geometry.size.height)

    fun drawScreen(canvas: Canvas, blinkVisible: Boolean = true) {
        canvas.save()
        canvas.clipRect(clip)
        canvas.drawRect(clip, Paint(background))
        for (cell in cells) {
            if (cell.background != background) canvas.drawRect(cell.bounds, Paint(cell.background))
        }
        for (highlight in selection)
            canvas.drawRect(highlight, Paint(appearance.selection))
        for (cell in cells) {
            if (!cell.blink || blinkVisible) drawGlyph(canvas, cell)
        }
        val separator = Paint(Color(foreground.red, foreground.green, foreground.blue, 0.2))
        for (y in separators)
            canvas.drawRect(Rect(0.0, y, geometry.size.width, 1.0), separator)
        canvas.restore()
    }

    fun drawSearchHighlights(canvas: Canvas, highlights: Array<TerminalHighlight>) {
        canvas.save();
        canvas.clipRect(clip)
        for (highlight in highlights)
            canvas
                .drawRect(
                    highlight.bounds,
                    Paint(
                        if (highlight.active)
                            appearance.activeSearchHighlight
                        else
                            appearance.searchHighlight
                    )
                )
        canvas.restore()
    }

    fun drawCursor(
        canvas: Canvas,
        rect: Rect,
        cursor: TerminalCursor,
        focused: Boolean,
        blinkVisible: Boolean,
        glyph: TextLayout? = None
    ) {
        canvas.save()
        canvas.clipRect(clip)
        if (cursor.visible && (!focused || !cursor.blink || blinkVisible)) {
            if (!focused) {
                canvas
                    .drawRect(
                        rect,
                        Paint(cursorColor, style = PaintingStyle.Stroke, strokeWidth = 1.0)
                    )
            } else
                when (cursor.shape) {
                    case Bar ->
                        canvas
                            .drawRect(
                                Rect(rect.x, rect.y, 2.0, rect.height),
                                Paint(cursorColor)
                            )
                    case Underline ->
                        canvas
                            .drawRect(
                                Rect(rect.x, rect.y + rect.height - 2.0, rect.width, 2.0),
                                Paint(cursorColor)
                            )

                    case Block -> {
                        canvas.drawRect(rect, Paint(cursorColor))
                        when (glyph) {
                            case Some(val text) -> {
                                canvas.save()
                                canvas.clipRect(rect)
                                canvas
                                    .drawText(
                                        text,
                                        Point(
                                            rect.x,
                                            rect.y +
                                                geometry.metrics.baseline -
                                                text.alphabeticBaseline
                                        )
                                    )
                                canvas.restore()
                            }

                            case None -> {}
                        }
                    }
                }
        }
        when (preedit) {
            case Some(val layout) -> {
                canvas
                    .drawRect(
                        Rect(rect.x, rect.y, layout.maxIntrinsicWidth, rect.height),
                        Paint(background)
                    )
                canvas
                    .drawText(
                        layout,
                        Point(
                            rect.x,
                            rect.y + geometry.metrics.baseline - layout.alphabeticBaseline
                        )
                    )
                canvas
                    .drawRect(
                        Rect(rect.x, rect.y + rect.height - 1.0, layout.maxIntrinsicWidth, 1.0),
                        Paint(cursorColor)
                    )
            }

            case None -> {}
        }
        canvas.restore()
    }

    fun drawLinks(canvas: Canvas, hovered: TerminalLink?) {
        val active = hovered ?: return
        canvas.save()
        canvas.clipRect(clip)
        for (link in links) {
            if (active.sameGroup(link.link))
                drawUnderline(canvas, link.bounds, TerminalUnderline.Single, link.color)
        }
        canvas.restore()
    }

    // A cursor-only scene can recolor one cached glyph without reshaping the grid.
    fun cursorGlyph(cursor: TerminalCursor): TextLayout? {
        if (cursor.shape !=
            TerminalCursorShape.Block ||
            !cursor.visible ||
            cursor.row >=
            geometry.rows.size ||
            cursor.column >=
            geometry.columns
        )
            return None
        val cell = geometry.rows[cursor.row].cells[cursor.column]
        if (cell.width == 0L || cell.text == "" || cell.style.concealed) return None
        val paper = if (cell.style.inverse)
            resolveColor(cell.style.foreground, foreground, colors)
        else
            resolveColor(cell.style.background, background, colors)
        return Some(glyphs.layout(cell, paper))
    }

    private fun drawGlyph(canvas: Canvas, cell: PaintCell) {
        val rect = cell.bounds
        val baseline = geometry.metrics.baseline
        when (cell.layout) {
            case Some(val text) -> {
                canvas.save()
                canvas.clipRect(rect)
                canvas.drawText(text, Point(rect.x, rect.y + baseline - text.alphabeticBaseline))
                canvas.restore()
            }

            case None -> {}
        }
        drawUnderline(canvas, rect, cell.underline, cell.underlineColor)
        if (cell.struck)
            canvas
                .drawRect(
                    Rect(rect.x, rect.y + baseline * 0.55, rect.width, 1.0),
                    Paint(cell.foreground)
                )
    }

    public override fun close() {
        try {
            preedit?.close()
        } finally {
            glyphs.release()
        }
    }
}

private fun drawUnderline(canvas: Canvas, rect: Rect, kind: TerminalUnderline, color: Color) {
    val y = rect.y + rect.height - 1.0
    val paint = Paint(color)
    when (kind) {
        case None -> {}
        case Single -> canvas.drawRect(Rect(rect.x, y, rect.width, 1.0), paint)

        case Double -> {
            canvas.drawRect(Rect(rect.x, y, rect.width, 1.0), paint)
            canvas.drawRect(Rect(rect.x, y - 2.0, rect.width, 1.0), paint)
        }

        case Curly -> {
            var x = rect.x
            var low = true
            while (x < rect.x + rect.width) {
                val end = if (x + 2.0 < rect.x + rect.width) x + 2.0 else rect.x + rect.width
                canvas
                    .drawLine(
                        Point(x, if (low) y else y - 2.0),
                        Point(end, if (low) y - 2.0 else y), paint
                    )
                x = end
                low = !low
            }
        }

        case _ -> {
            val width = if (kind == TerminalUnderline.Dotted) 1.0 else 3.0
            var x = rect.x
            while (x < rect.x + rect.width) {
                val remaining = rect.x + rect.width - x
                canvas.drawRect(Rect(x, y, if (remaining < width) remaining else width, 1.0), paint)
                x += width + 2.0
            }
        }
    }
}
