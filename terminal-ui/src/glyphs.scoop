package scoop.ui.terminal

import scoop.collections.HashMap
import scoop.graphics.Color
import scoop.graphics.text.*
import scoop.terminal.emulator.TerminalCell

internal struct CellMetrics(val width: Double, val height: Double, val baseline: Double)

private const val GLYPH_CACHE_LIMIT = 1024L

private const val GLYPH_CACHE_BYTES = 16L * 1024L * 1024L

/** LRU ownership and frame ownership are independent; eviction never closes a leased layout. */
internal class TerminalGlyphCache(
    private val fonts: FontCollection,
    private val appearance: TerminalAppearance,
    private val maxEntries: Long = GLYPH_CACHE_LIMIT,
    private val maxBytes: Long = GLYPH_CACHE_BYTES
) {
    private val fontRevision = fonts.revision
    private val source = glyphFontSource(fonts, appearance, maxEntries, maxBytes)
    private val layouts = HashMap<GlyphKey, GlyphCacheEntry>()
    private var oldest: GlyphCacheEntry? = None
    private var newest: GlyphCacheEntry? = None
    private var bytes = 0L
    private var shaped = 0L
    private var references = 1L

    val metrics: CellMetrics get() = source.metrics
    val cachedCount: Long get() = layouts.size
    val estimatedBytes: Long get() = bytes
    val shapeCount: Long get() = shaped

    fun canReuse(fonts: FontCollection, appearance: TerminalAppearance): Boolean {
        if (references ==
            0L ||
            this.fonts !==
            fonts ||
            fontRevision !=
            fonts.revision ||
            this.appearance.fontSize !=
            appearance.fontSize ||
            this.appearance.families.size !=
            appearance.families.size
        )
            return false
        for (index in 0L..<appearance.families.size)
            if (this.appearance.families[index] != appearance.families[index]) return false
        return true
    }

    fun acquire(cell: TerminalCell, ink: Color): TerminalGlyphLease = acquire(
        cell.displayText,
        cell.style.bold,
        cell.style.italic,
        ink
    )

    fun acquire(text: String, bold: Boolean, italic: Boolean, ink: Color): TerminalGlyphLease {
        ensureOpen()
        val key = GlyphKey(
            text, bold, italic, ink.red.toBits(),
            ink.green.toBits(), ink.blue.toBits(), ink.alpha.toBits()
        )
        when (layouts[key]) {
            case Some(val cached) -> {
                touch(cached)
                return TerminalGlyphLease(cached.resource)
            }

            case None -> {}
        }
        val layout = shapeText(source.fonts, key.text, appearance, ink, key.bold, key.italic)
        shaped += 1L
        // A conservative cache weight, not a measurement of the native allocator's RSS.
        val cost = 256L + text.byteLength * 2L + text.charLength * 64L
        val entry = GlyphCacheEntry(key, TerminalGlyphResource(layout), cost)
        layouts[key] = entry
        append(entry)
        bytes += cost
        val lease = TerminalGlyphLease(entry.resource)
        while (layouts.size > maxEntries || bytes > maxBytes)
            evictOldest()
        return lease
    }

    fun shapePreedit(text: String, foreground: Color): TextLayout {
        ensureOpen()
        return shapeText(source.fonts, text, appearance, foreground)
    }

    private fun append(entry: GlyphCacheEntry) {
        entry.previous = newest
        when (newest) {
            case Some(val last) -> last.next = Some(entry)
            case None -> oldest = Some(entry)
        }
        newest = Some(entry)
    }

    private fun detach(entry: GlyphCacheEntry) {
        when (entry.previous) {
            case Some(val previous) -> previous.next = entry.next
            case None -> oldest = entry.next
        }
        when (entry.next) {
            case Some(val next) -> next.previous = entry.previous
            case None -> newest = entry.previous
        }
        entry.previous = None
        entry.next = None
    }

    private fun touch(entry: GlyphCacheEntry) {
        when (newest) {
            case Some(val last) -> if (last === entry) return
            case None -> {}
        }
        detach(entry)
        append(entry)
    }

    private fun evictOldest() {
        val entry = oldest ?: return
        detach(entry)
        layouts.remove(entry.key)
        bytes -= entry.cost
        entry.resource.release()
    }

    private fun ensureOpen() {
        if (references == 0L) throw IllegalStateException(Some("terminal glyph cache is closed"))
    }

    fun retain() {
        ensureOpen()
        references += 1L
    }

    fun release() {
        ensureOpen()
        references -= 1L
        if (references != 0L) return
        try {
            while (layouts.size > 0L)
                evictOldest()
        } finally {
            source.fonts.close()
        }
    }
}

private struct GlyphFontSource(val fonts: FontCollection, val metrics: CellMetrics)

private fun glyphFontSource(
    fonts: FontCollection,
    appearance: TerminalAppearance,
    maxEntries: Long,
    maxBytes: Long
): GlyphFontSource {
    if (maxEntries < 1L || maxBytes < 1L)
        throw IllegalArgumentException(Some("terminal glyph cache limits must be positive"))
    val snapshot = fonts.copy()
    try {
        val metrics = shapeText(snapshot, "M", appearance, appearance.foreground)
            .use { layout ->
                CellMetrics(layout.maxIntrinsicWidth, layout.size.height, layout.alphabeticBaseline)
            }
        return GlyphFontSource(snapshot, metrics)
    } catch (error: Throwable) {
        snapshot.close()
        throw error
    }
}

private class GlyphCacheEntry(
    val key: GlyphKey,
    val resource: TerminalGlyphResource,
    val cost: Long
) {
    var previous: GlyphCacheEntry? = None
    var next: GlyphCacheEntry? = None
}

internal class TerminalGlyphResource(val layout: TextLayout) {
    private var references = 1L
    fun retain() {
        references += 1L
    }
    fun release() {
        references -= 1L
        if (references == 0L) layout.close()
    }
}

/** Each caller owns a separate idempotently closed reference to one immutable layout. */
internal class TerminalGlyphLease(private val resource: TerminalGlyphResource) : Closeable {
    private var closed = false
    val layout: TextLayout
        get() {
            if (closed) throw IllegalStateException(Some("terminal glyph lease is closed"))
            return resource.layout
        }
    init {
        resource.retain()
    }
    public override fun close() {
        if (closed) return
        closed = true
        resource.release()
    }
}

private struct GlyphKey(
    val text: String,
    val bold: Boolean,
    val italic: Boolean,
    val red: Long,
    val green: Long,
    val blue: Long,
    val alpha: Long
) : Equals<GlyphKey>, Hash {
    public override operator fun equals(other: GlyphKey): Boolean = text ==
        other.text &&
        bold ==
        other.bold &&
        italic ==
        other.italic &&
        red ==
        other.red &&
        green ==
        other.green &&
        blue ==
        other.blue &&
        alpha ==
        other.alpha

    public override fun hash(): Long {
        var hash = text.hash()
        hash = hash * 31L + bold.hash()
        hash = hash * 31L + italic.hash()
        hash = hash * 31L + red.hash()
        hash = hash * 31L + green.hash()
        hash = hash * 31L + blue.hash()
        return hash * 31L + alpha.hash()
    }
}

private fun shapeText(
    fonts: FontCollection,
    value: String,
    appearance: TerminalAppearance,
    foreground: Color,
    bold: Boolean = false,
    italic: Boolean = false
): TextLayout {
    val style = textStyle {
        families = appearance.families
        fontSize = appearance.fontSize
        color = foreground
        weight = if (bold) 700 else 400
        slant = if (italic) FontSlant.Italic else FontSlant.Upright
    }
    return Paragraph(fonts, value, style).use { paragraph -> paragraph.layoutUnwrapped() }
}
