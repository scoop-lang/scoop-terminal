package scoop.ui.terminal

import scoop.collections.HashMap
import scoop.platform.concurrent.currentThreadId
import scoop.platform.time.*
import scoop.terminal.emulator.*

internal struct TerminalModelSize(val columns: Long, val rows: Long, val pixels: TerminalPixelSize?)

internal struct TerminalModelTrackRequest(
    val id: Long,
    val range: TerminalRange,
    val kind: TerminalTrackingKind,
    val source: TerminalReading,
    val closed: AtomicBoolean
)

internal struct TerminalModelBinding(
    val id: Long,
    val coreId: Long,
    val state: TerminalTrackingState,
    val presentation: Long
)

internal enum TerminalModelCommand {
    Feed(Array<Byte>), Input(TerminalInput), Resize(TerminalModelSize, Boolean),
    Colors(TerminalColors), Width(TerminalAmbiguousWidth), ReleaseSynchronization(Long), Finish,
    Track(TerminalModelTrackRequest), Untrack(Array<Long>), Barrier
}

/** Only immutable core values and lease identities cross back to the window owner. */
internal struct TerminalModelPublication(
    val reading: TerminalReading,
    val update: TerminalUpdate,
    val input: Array<Byte>,
    val size: TerminalModelSize,
    val resizePty: Boolean,
    val completedResize: TerminalModelSize?,
    val mouseReporting: Boolean,
    val metadata: TerminalMetadata,
    val ambiguousWidth: TerminalAmbiguousWidth,
    val synchronizationGeneration: Long,
    val synchronizedSince: MonotonicInstant?,
    val binding: TerminalModelBinding?,
    val imageLease: TerminalImageLease
) {
    fun withoutImages(): TerminalModelPublication {
        val text = reading.withoutImages()
        return TerminalModelPublication(
            text, update, input, size, resizePty, completedResize, mouseReporting, metadata,
            ambiguousWidth, synchronizationGeneration, synchronizedSince, binding,
            text.images.retain()
        )
    }
}

/** Constructed, accessed and retired only on one background worker. */
internal class TerminalModelState(private val terminal: Terminal) {
    val owner = currentThreadId()
    private val tracked = HashMap<Long, TerminalTrackedRange>()
    private var synchronizedSince: MonotonicInstant? = None
    val initial = publication(TerminalUpdate(false, []))

    fun apply(command: TerminalModelCommand): TerminalModelPublication {
        checkOwner()
        val started = MonotonicTimeSource.now()
        val generation = terminal.synchronizationGeneration
        var input: Array<Byte> = []
        var resized = false
        var completedResize: TerminalModelSize? = None
        var binding: TerminalModelBinding? = None
        val update = when (command) {
            case Feed(val bytes) -> terminal.feed(bytes)

            case Input(val value) -> {
                input = terminal.encodeInput(value)
                TerminalUpdate(false, [])
            }

            case Resize(val size, val restoreHistory) -> {
                completedResize = Some(size)
                resized = size.columns != terminal.columns || size.rows != terminal.rows
                terminal.resize(size.columns, size.rows, restoreHistory, size.pixels)
            }

            case Colors(val colors) -> terminal.setColors(colors)
            case Width(val width) -> terminal.setAmbiguousWidth(width)
            case ReleaseSynchronization(val requested) ->
                if (requested == generation && terminal.synchronizedOutput)
                    terminal.releaseSynchronizedOutput()
                else
                    TerminalUpdate(false, [])
            case Finish -> terminal.finishOutput()

            case Track(val request) -> {
                if (request.closed.load()) {
                    TerminalUpdate(false, [])
                } else {
                    try {
                        val handle = terminal
                            .track(request.range, request.kind, Some(request.source))
                        tracked[request.id] = handle
                        val updated = terminal.feed([])
                        binding = Some(
                            TerminalModelBinding(
                                request.id, handle.id,
                                handle.state(terminal.reading), terminal.reading.presentationVersion
                            )
                        )
                        updated
                    } catch (_: IllegalStateException) {
                        binding = Some(
                            TerminalModelBinding(
                                request.id, 0L,
                                TerminalTrackingState.Invalidated(TerminalInvalidation.Rejected),
                                terminal.reading.presentationVersion
                            )
                        )
                        TerminalUpdate(
                            false,
                            [TerminalEffect.Diagnostic("terminal tracking request rejected")]
                        )
                    }
                }
            }

            case Untrack(val ids) -> {
                for (id in ids) {
                    tracked[id]?.close()
                    tracked.remove(id)
                }
                terminal.feed([])
            }

            case Barrier -> TerminalUpdate(false, [])
        }
        if (!terminal.synchronizedOutput)
            synchronizedSince = None
        else if (generation != terminal.synchronizationGeneration || synchronizedSince == None)
            synchronizedSince = Some(started)
        return publication(update, input, resized, binding, completedResize)
    }

    fun close() {
        checkOwner()
        for (handle in tracked.values)
            handle.close()
        tracked.clear()
        terminal.close()
    }

    private fun checkOwner() {
        if (currentThreadId() != owner)
            throw IllegalStateException(Some("terminal model accessed from another worker"))
    }

    private fun publication(
        update: TerminalUpdate,
        input: Array<Byte> = [],
        resizePty: Boolean = false,
        binding: TerminalModelBinding? = None,
        completedResize: TerminalModelSize? = None
    ): TerminalModelPublication = TerminalModelPublication(
        terminal.reading, update, input,
        TerminalModelSize(terminal.columns, terminal.rows, terminal.pixelSize), resizePty,
        completedResize,
        terminal.mouseReporting, terminal.metadata, terminal.ambiguousWidth,
        terminal.synchronizationGeneration, synchronizedSince, binding, terminal
            .reading
            .images
            .retain()
    )
}

internal fun modelCommandBytes(command: TerminalModelCommand): Long = when (command) {
    case Feed(val bytes) -> bytes.size
    case Input(val input) ->
        when (input) {
            case Text(val text) -> text.byteLength
            case Paste(val text) -> text.byteLength + 12L
            case _ -> 64L
        }
    case Colors(_) -> 8192L
    case _ -> 256L
}
