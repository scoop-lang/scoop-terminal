package scoop.ui.terminal

import scoop.graphics.Color
import scoop.graphics.text.FontCollection
import scoop.terminal.emulator.TerminalCell
import scoop.terminal.emulator.TerminalStyle
import scoop.test.*

@Test
private class TerminalGlyphCacheTest {
    @Test
    fun narrowWideCellsShapeThePlaceholderAndKeepOriginalText() {
        FontCollection()
            .use { fonts ->
                val cache = TerminalGlyphCache(fonts, TerminalAppearance())
                try {
                    val cell = TerminalCell("中", 1L, intrinsicWidth = 2L)
                    val layout = cache.layout(cell, Color.White)
                    assertEquals("�", layout.text)
                    assertEquals("中", cell.text)
                    assertTrue(layout === cache.layout(TerminalCell("�"), Color.White))
                    assertEquals("中", cache.layout(TerminalCell("中", 2L), Color.White).text)
                } finally {
                    cache.release()
                }
            }
    }

    @Test
    fun sharesGlyphsWithTheSameInkAndKeepsRetainedFramesAlive() {
        FontCollection()
            .use { fonts ->
                val cache = TerminalGlyphCache(fonts, TerminalAppearance())
                val cell = TerminalCell("A", 1L, TerminalStyle())
                val plain = cache.layout(cell, Color.White)
                cache.retain()
                cache.release()
                try {
                    assertTrue(plain === cache.layout(cell, Color.White))
                    assertTrue(plain !== cache.layout(cell, Color.Black))
                    val bold = TerminalCell("A", 1L, TerminalStyle(flags = 1))
                    assertTrue(plain !== cache.layout(bold, Color.White))
                    assertTrue(!plain.isClosed)
                } finally {
                    cache.release()
                }
                assertTrue(plain.isClosed)
            }
    }
}
