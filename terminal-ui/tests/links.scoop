package scoop.ui.terminal

import scoop.graphics.*
import scoop.graphics.text.FontCollection
import scoop.terminal.emulator.*
import scoop.test.*

@Test
private class TerminalLinkInteractionTest {
    @Test
    fun hitTestsUseTheAcceptedReadingIncludingWideTails() {
        val terminal = Terminal(4L, 1L)
        terminal.feed("\u001b]8;;https://displayed\u0007中\u001b]8;;\u0007".toByteArray())
        val reading = terminal.reading
        val frame = GridGeometry(
            Size(40.0, 16.0), CellMetrics(10.0, 16.0, 12.0), 0L,
            reading.lines(0L, 1L), 4L, 1L, reading.screenRevision, true, reading
        )
        terminal.feed("\r\u001b]8;;https://pending\u0007new\u001b]8;;\u0007".toByteArray())
        assertEquals(Some("https://displayed"), frame.linkAt(Point(15.0, 8.0))?.uri)
        assertEquals(None, frame.linkAt(Point(20.0, 8.0))?.uri)
        assertEquals(None, frame.linkAt(Point(-1.0, 8.0))?.uri)
        assertEquals(Some((0L, 3L)), frame.clampedHit(Point(100.0, 30.0)))
    }

    @Test
    fun draggingLeavingAndCancellationNeverActivateThePressedLink() {
        val terminal = Terminal(4L, 1L)
        terminal
            .feed(
                "\u001b]8;;https://one\u0007x\u001b]8;;https://two\u0007y\u001b]8;;\u0007"
                    .toByteArray()
            )
        val first = terminal.reading.linkAt(0L, 0L)!!
        val second = terminal.reading.linkAt(0L, 1L)!!
        val origin = CellLocation(terminal.reading.lines(0L, 1L)[0L].id, 0L)
        val pixels = TerminalPixelPosition(10L, 10L)
        val gesture = TerminalLinkGesture()
        gesture.begin(first, origin, pixels, 2.0)
        assertEquals(None, gesture.drag(TerminalPixelPosition(15L, 10L)))
        assertEquals(Some(first.key), gesture.release(Some(first), pixels)?.key)
        gesture.begin(first, origin, pixels, 2.0)
        assertEquals(Some(origin), gesture.drag(TerminalPixelPosition(16L, 10L)))
        assertEquals(None, gesture.release(Some(first), pixels)?.key)
        gesture.begin(first, origin, pixels, 1.0)
        assertEquals(None, gesture.release(Some(second), pixels)?.key)
        gesture.begin(first, origin, pixels, 1.0)
        assertEquals(None, gesture.release(None, pixels)?.key)
        gesture.begin(first, origin, pixels, 1.0)
        gesture.cancel()
        assertFalse(gesture.active)
        assertEquals(None, gesture.release(Some(first), pixels)?.key)
    }

    @Test
    fun hoverDecoratesMatchingFragmentsWithoutRebuildingText() {
        val terminal = Terminal(3L, 1L)
        terminal
            .feed(
                "\u001b]8;id=x;https://one\u0007 \u001b]8;;\u0007 \u001b]8;id=x:future=y;https://one\u0007 \u001b]8;;\u0007"
                    .toByteArray()
            )
        val appearance = TerminalAppearance(background = Color.Black, foreground = Color.White)
        terminal.setColors(appearance.colorTheme())
        val reading = terminal.reading
        val geometry = GridGeometry(
            Size(30.0, 16.0), CellMetrics(10.0, 16.0, 12.0), 0L,
            reading.lines(0L, 1L), 3L, 1L, reading.screenRevision, true, reading
        )
        FontCollection()
            .use { fonts ->
                val glyphs = TerminalGlyphCache(fonts, appearance)
                try {
                    TerminalFrame(geometry, 1L, reading.cursor, 0L, appearance, glyphs)
                        .use { frame ->
                            frame.shape([], "")
                            RasterSurface(30, 16)
                                .use { surface ->
                                    surface
                                        .draw { canvas ->
                                            frame.drawScreen(canvas);
                                            frame.drawLinks(canvas, reading.linkAt(0L, 0L))
                                        }
                                    val pixels = surface.readPixels()
                                    for (column in 0L..<3L)
                                        assertEquals(
                                            if (column == 1L) 0 else 255,
                                            pixels[(15L * 30L + column * 10L + 5L) * 4L].toInt() and
                                                255
                                        )
                                    surface
                                        .draw { canvas ->
                                            frame.drawScreen(canvas);
                                            frame.drawLinks(canvas, None)
                                        }
                                    assertEquals(
                                        0,
                                        surface.readPixels()[(15L * 30L + 5L) * 4L].toInt() and 255
                                    )
                                }
                        }
                } finally {
                    glyphs.release()
                }
            }
    }
}
